## Clove's max engine (engine 1): a bitwise context-mixing model with a
## long-range match model (the LZ part), two gated logistic mixers, two SSE
## stages and a carry-less arithmetic coder. Integer arithmetic only, so every
## machine produces and reads the same bytes.
##
## Per bit, eight hashed context models (orders 1-4 and 6, the current word,
## the word pair, and a sparse context that skips a byte; in machine code the two
## word contexts become instruction contexts, see Model.end_byte), a direct order-0
## model and the match model each give a probability. A hashed slot holds a bit
## history (a state of the machine in `states`: how many zeros and ones were seen
## and which came last), and an adaptive map per order turns the state into a
## probability, so a context that has seen "0 0 0 1" and one that has seen
## "1 0 0 0" predict differently although both counted the same bits. Each
## history gives the mixers two inputs: its logit and, when it has been seen at
## all, its linear lean. Two mixers weigh the inputs, one by the partial byte and
## one by the previous byte and the match state; a final two-weight mixer per bit
## position joins them; two SSE stages refine the result by order-0 and order-1
## context. Each nibble bucket carries a check byte, so a hash collision clears
## the bucket instead of mixing two contexts' histories. Table sizes grow with
## the block (both sides know its length), so small blocks stay cheap.

NORD := 8
NIN := 19
LIMIT := 255
INIT := 1073741824
NSTATES := 175
## The history tables stop growing at 2^TCAP slots per order (a slot is one byte).
TCAP := 22
RUNCAP := 40
MIXCAP := 12

## squash/stretch as in the lpaq family: 12-bit probabilities, logits in -2047..2047.
SQ := [
    1,
    2,
    3,
    6,
    10,
    16,
    27,
    45,
    73,
    120,
    194,
    310,
    488,
    747,
    1101,
    1546,
    2047,
    2549,
    2994,
    3348,
    3607,
    3785,
    3901,
    3975,
    4022,
    4050,
    4068,
    4079,
    4085,
    4089,
    4092,
    4093,
    4094,
]

fn squash(d int) int
    if d > 2047
        return 4095
    if d < -2047
        return 0
    w := (d + 2048).bit_and(127)
    i := (d + 2048).shr(7)
    (SQ[i] * (128 - w) + SQ[i + 1] * w + 64).shr(7)

fn stretch_table() List[int]
    mut t := [0 for _ in 0..4096]
    mut pi := 0
    for x in -2047..2048
        v := squash(x)
        for i in pi..=v
            t[i] = x
        pi = v + 1
    t

fn delta_table() List[int]
    [131072 / (2 * n + 3) for n in 0..1024]

## Table slots hold a 21-bit probability over a 10-bit hit count in a u32; the count
## sets the learning rate (fast at first, then settling at 1/limit). See Model.adapt.

fn fold(x int) int
    x.bit_xor(x.shr(32)).bit_and(268435455)

fn bits_for(n int, lo int, hi int) int
    mut b := lo
    while b < hi and (1).shl(b) < n
        b += 1
    b

## The bit-history machine. A state is (zeros, ones, last bit); seeing a bit adds
## one to its count and, when the other count is above two, halves that count (the
## statistics are nonstationary: old evidence fades). A pure run counts to RUNCAP;
## once both bits were seen the larger count stops at MIXCAP. The reachable states
## are numbered in breadth-first order from (0, 0, 0), state 0 meaning never seen;
## there are NSTATES of them. `nex[s * 2 + y]` is the state after bit y, and
## `zeros`/`ones` give each state's counts for the maps' starting probabilities.
struct States
    nex List[int]
    zeros List[int]
    ones List[int]

fn next_counts(n0 int, n1 int, y int)(int, int)
    mut a := n0
    mut b := n1
    if y == 1
        b += 1
        if a > 2
            a = a / 2 + 1
    else
        a += 1
        if b > 2
            b = b / 2 + 1
    if b == 0
        a = a.min(RUNCAP)
    elif a == 0
        b = b.min(RUNCAP)
    elif a > b
        a = a.min(MIXCAP)
    else
        b = b.min(MIXCAP)
    (a, b)

fn build_states() States
    mut ids := [0 for _ in 0..(RUNCAP + 1) * (RUNCAP + 1) * 2]
    mut zeros := [0]
    mut ones := [0]
    mut last := [0]
    mut nex := List[int]()
    ids[0] = 1
    mut head := 0
    while head < zeros.len()
        n0 := zeros[head]
        n1 := ones[head]
        for y in 0..2
            t := next_counts(n0, n1, y)
            key := (t.0 * (RUNCAP + 1) + t.1) * 2 + y
            if ids[key] == 0
                zeros.push(t.0)
                ones.push(t.1)
                last.push(y)
                ids[key] = zeros.len()
            nex.push(ids[key] - 1)
        head += 1
    States(nex: nex, zeros: zeros, ones: ones)

## The starting probability of a state: (ones + 1/2) / (zeros + ones + 1), 21 bits, count 0.
fn map_init(st States) List[int]
    [
        ((st.ones[s] * 2 + 1).shl(21) / (st.zeros[s] * 2 + st.ones[s] * 2 + 2)).shl(10)
        for s in 0..NSTATES
    ]

## The SSE curve of context `cx`: 33 points over the logit range (0..65661, so u32).
fn apm_init(nctx int) List[u32]
    curve := [(squash((j - 16) * 128) * 16).to_u32() for j in 0..33]
    [curve[k % 33] for k in 0..nctx * 33]

struct Model
    t List[u8]
    tbits int
    o0 List[int]
    idx List[int]
    bkt List[int]
    hv List[int]
    chk List[int]
    nex List[int]
    sm List[int]
    cur List[int]
    st List[int]
    wa List[int]
    wb List[int]
    wf List[int]
    dotf int
    msm List[int]
    mtab List[u32]
    mbits int
    a1 List[u32]
    a2 List[u32]
    buf List[u8]
    sq List[int]
    dt List[int]
    c0 int
    c4 int
    c8 int
    word0 int
    word1 int
    bitpos int
    mptr int
    mlen int
    mctx int
    sela int
    selb int
    dota int
    dotb int
    pmix int
    i1 int
    i2 int
    pr int
    exe int

## A model for an `n`-byte block; `exe` is the block's executable filter (0 for data).
fn new_model(n int, exe int) Model
    tbits := bits_for(n * 2, 12, TCAP)
    mbits := bits_for(n, 10, 20)
    states := build_states()
    one_map := map_init(states)
    mut sm := List[int]()
    for _ in 0..NORD
        sm.extend(one_map)
    mut m := Model(
        t: [(0).to_u8() for _ in 0..NORD * (1).shl(tbits)],
        tbits: tbits,
        o0: [INIT for _ in 0..256],
        idx: [0 for _ in 0..NORD],
        bkt: [0 for _ in 0..NORD],
        hv: [0 for _ in 0..NORD],
        chk: [0 for _ in 0..NORD],
        nex: states.nex,
        sm: sm,
        cur: [0 for _ in 0..NORD],
        st: [0 for _ in 0..NIN],
        wa: [
            if k % NIN < 1 + NORD or k % NIN >= 1 + 2 * NORD then 16000 else 4000
            for k in 0..NIN * 256
        ],
        wb: [
            if k % NIN < 1 + NORD or k % NIN >= 1 + 2 * NORD then 16000 else 4000
            for k in 0..NIN * 1024
        ],
        wf: [32768 for _ in 0..16],
        dotf: 0,
        msm: [INIT for _ in 0..64],
        mtab: [(0).to_u32() for _ in 0..(1).shl(mbits)],
        mbits: mbits,
        a1: apm_init(256),
        a2: apm_init(65536),
        buf: [],
        sq: stretch_table(),
        dt: delta_table(),
        c0: 1,
        c4: 0,
        c8: 0,
        word0: 0,
        word1: 0,
        bitpos: 0,
        mptr: 0,
        mlen: 0,
        mctx: 0,
        sela: 0,
        selb: 0,
        dota: 0,
        dotb: 0,
        pmix: 2048,
        i1: 0,
        i2: 0,
        pr: 2048,
        exe: exe,
    )
    m.set_idx()
    m

## Slots of the context models for the next bit. Each context hashes once per
## nibble to a bucket of 16 one-byte slots (four buckets to a cache line); the bits of the
## nibble so far pick slots 1..15, so a byte costs two cache misses per context
## instead of eight. Slot 0 holds a check byte from other bits of the hash: a
## bucket that belongs to a different context is cleared before use.
fn Model.set_idx(mut self)
    if self.bitpos == 0 or self.bitpos == 4
        bmask := (1).shl(self.tbits - 4) - 1
        for i in 0..NORD
            h := (self.hv[i] + self.c0 * 40503) * 2654435761
            self.bkt[i] = h.shr(20).bit_and(bmask).shl(4) + i.shl(self.tbits)
            check := h.shr(44).bit_and(255)
            if self.t[self.bkt[i]].to_int() != check
                self.t[self.bkt[i]] = check.to_u8()
                for k in 1..16
                    self.t[self.bkt[i] + k] = (0).to_u8()
    nib := if self.bitpos < 4 then self.c0 else (1).shl(self.bitpos - 4)
        + self.c0.bit_and((1).shl(self.bitpos - 4) - 1)
    for i in 0..NORD
        self.idx[i] = self.bkt[i] + nib

## SSE: interpolate the curve of context `cx` (stage 1 or 2) at p's logit.
fn Model.apm(mut self, stage int, cx int, p int) int
    s := self.sq[p] + 2048
    j := cx * 33 + s.shr(7)
    w := s.bit_and(127)
    if stage == 1
        return (self.a1[j].to_int() * (128 - w) + self.a1[j + 1].to_int() * w).shr(11)
    (self.a2[j].to_int() * (128 - w) + self.a2[j + 1].to_int() * w).shr(11)

fn Model.adapt(mut self, e int, y int, limit int) int
    n := e.bit_and(1023)
    p := e.shr(10)
    p2 := p + ((y.shl(21) - p) * self.dt[n]) / 65536
    n2 := if n < limit then n + 1 else n
    p2.shl(10) + n2

## The probability (12 bits) that the next bit is 1. Inputs: 0 the order-0 model,
## 1..8 the histories' logits, 9 the match model, 10 a bias, 11..18 the histories'
## linear leans (0 for a context never seen).
fn Model.predict(mut self) int
    self.st[0] = self.sq[self.o0[self.c0].shr(19)]
    for i in 0..NORD
        # The mask makes a full-width int for `cur`: AIL before 53fa67de stored
        # a widened sized value at its narrow width (type.num.15).
        s := self.t[self.idx[i]].to_int().bit_and(255)
        self.cur[i] = s
        p := self.sm[i * NSTATES + s].shr(19)
        self.st[i + 1] = self.sq[p]
        self.st[11 + i] = if s == 0 then 0 else (p - 2048) / 4
    mut active := 0
    self.st[9] = 0
    self.mctx = -1
    if self.mlen > 0
        e := self.buf[self.mptr].to_int()
        if (e + 256).shr(8 - self.bitpos) == self.c0
            active = 1
            eb := e.shr(7 - self.bitpos).bit_and(1)
            lb := if self.mlen < 16 then self.mlen else 16 + ((self.mlen - 16) / 8).min(15)
            self.mctx = lb * 2 + eb
            self.st[9] = self.sq[self.msm[self.mctx].shr(19)]
    self.st[10] = 256
    mut mb := 0
    if active == 1
        mb = 3
        if self.mlen < 16
            mb = 1
        elif self.mlen < 32
            mb = 2
    self.sela = self.c0 * NIN
    self.selb = (self.c4.bit_and(255) + 256 * mb) * NIN
    mut da := 0
    mut db := 0
    for k in 0..NIN
        da += self.wa[self.sela + k] * self.st[k]
        db += self.wb[self.selb + k] * self.st[k]
    self.dota = (da / 65536).max(-2047).min(2047)
    self.dotb = (db / 65536).max(-2047).min(2047)
    self.dotf = ((self.wf[self.bitpos * 2] * self.dota + self.wf[self.bitpos * 2 + 1] * self.dotb) / 65536)
        .max(-2047)
        .min(2047)
    self.pmix = squash(self.dotf).max(1).min(4095)
    self.i1 = self.c0
    self.i2 = self.c0 + self.c4.bit_and(255).shl(8)
    p1 := self.apm(1, self.i1, self.pmix)
    p2 := self.apm(2, self.i2, self.pmix)
    self.pr = ((self.pmix + p1 + 2 * p2) / 4).max(1).min(4095)
    self.pr

fn Model.update(mut self, y int)
    ea := (y.shl(12) - squash(self.dota)) * 6
    eb := (y.shl(12) - squash(self.dotb)) * 6
    for k in 0..NIN
        self.wa[self.sela + k] += (self.st[k] * ea + 32768) / 65536
        self.wb[self.selb + k] += (self.st[k] * eb + 32768) / 65536
    ef := (y.shl(12) - self.pmix) * 2
    self.wf[self.bitpos * 2] += (self.dota * ef + 32768) / 65536
    self.wf[self.bitpos * 2 + 1] += (self.dotb * ef + 32768) / 65536
    s := self.sq[self.pmix] + 2048
    j0 := s.shr(7)
    near := if s.bit_and(127) < 64 then j0 else j0 + 1
    g := y.shl(16) + y.shl(7) - y - y
    j1 := self.i1 * 33 + near
    v1 := self.a1[j1].to_int()
    self.a1[j1] = (v1 + (g - v1) / 128).to_u32()
    j2 := self.i2 * 33 + near
    v2 := self.a2[j2].to_int()
    self.a2[j2] = (v2 + (g - v2) / 128).to_u32()
    e0 := self.adapt(self.o0[self.c0], y, LIMIT)
    self.o0[self.c0] = e0
    for i in 0..NORD
        hs := self.cur[i]
        j := i * NSTATES + hs
        self.sm[j] = self.adapt(self.sm[j], y, LIMIT)
        self.t[self.idx[i]] = self.nex[hs * 2 + y].to_u8()
    if self.mctx >= 0
        em := self.adapt(self.msm[self.mctx], y, 1023)
        self.msm[self.mctx] = em
    self.c0 = self.c0 * 2 + y
    self.bitpos += 1
    if self.bitpos == 8
        self.end_byte(self.c0 - 256)
        self.c0 = 1
        self.bitpos = 0
    self.set_idx()

fn Model.end_byte(mut self, b int)
    self.buf.push(b.to_u8())
    self.c8 = self.c8.shl(8).bit_and(4294967295).bit_or(self.c4.shr(24))
    self.c4 = self.c4.shl(8).bit_and(4294967295).bit_or(b)
    lower := if b >= 65 and b <= 90 then b + 32 else b
    if (lower >= 97 and lower <= 122) or b >= 128
        self.word0 = (self.word0 * 263 + lower).bit_and(1073741823)
    elif self.word0 != 0
        self.word1 = self.word0
        self.word0 = 0
    self.hv[0] = self.c4.bit_and(255) * 65599 + 1
    self.hv[1] = self.c4.bit_and(65535) * 31 + 2
    self.hv[2] = fold(self.c4.bit_and(16777215) * 2246822519) + 3
    self.hv[3] = fold(self.c4.shr(16) * 2246822519 + self.c4.bit_and(65535) * 3266489917) + 4
    self.hv[4] = fold(self.c4.bit_xor(self.c8.bit_and(65535) * 2654435761)) + 5
    n := self.buf.len()
    if self.exe == 0
        self.hv[5] = fold(self.word0 * 2654435761) + 6
        self.hv[6] = fold(self.word0.bit_xor(self.word1 * 1000003) * 97) + 7
    else
        # Machine code: bytes 1 and 3 back (an opcode and its operand around a
        # ModRM byte), and the column in a 4-byte word with the bytes 4 and 8 back
        # (the same field of the previous instructions on ARM64, table entries on x86).
        self.hv[5] = fold((self.c4.bit_and(16711935) + 16777216) * 2654435761) + 6
        self.hv[6] = fold((n.bit_and(3) + self.c4.shr(24).shl(2) + self.c8.shr(24).shl(10)) * 2246822519)
            + 7
    self.hv[7] = fold(self.c4.shr(8).bit_and(65535) * 2246822519) + 8
    if self.mlen > 0 and self.buf[self.mptr].to_int() == b
        self.mlen += 1
        self.mptr += 1
    else
        self.mlen = 0
    h := (fold(self.c4 + self.c8.bit_and(255).shl(32)) * 789008181)
        .shr(20)
        .bit_and((1).shl(self.mbits) - 1)
    if self.mlen == 0
        cand := self.mtab[h].to_int()
        if cand > 0
            mut k := 0
            while k < 32 and cand - 1 - k >= 0 and self.buf[cand - 1 - k] == self.buf[n - 1 - k]
                k += 1
            if k >= 5
                self.mlen = k
                self.mptr = cand
    self.mtab[h] = n.to_u32()

struct Coder
    out List[u8]
    x1 int
    x2 int

## Compresses `d` to a self-contained block; `exe` as for new_model.
pub fn compress(d List[u8], exe int) List[u8]
    mut m := new_model(d.len(), exe)
    mut c := Coder(out: [], x1: 0, x2: 4294967295)
    for byte in d
        b := byte.to_int()
        mut i := 7
        while i >= 0
            y := b.shr(i).bit_and(1)
            p := m.predict()
            xmid := c.x1 + (c.x2 - c.x1).shr(12) * p
            if y == 1
                c.x2 = xmid
            else
                c.x1 = xmid + 1
            m.update(y)
            while c.x1.bit_xor(c.x2).bit_and(4278190080) == 0
                c.out.push(c.x2.shr(24).to_u8())
                c.x1 = c.x1.shl(8).bit_and(4294967295)
                c.x2 = c.x2.shl(8).bit_and(4294967295).bit_or(255)
            i -= 1
    c.out.push(c.x1.shr(24).to_u8())
    c.out.push(c.x1.shr(16).bit_and(255).to_u8())
    c.out.push(c.x1.shr(8).bit_and(255).to_u8())
    c.out.push(c.x1.bit_and(255).to_u8())
    c.out

## Decodes `n` bytes. A damaged block gives wrong bytes, which the caller's CRC catches.
pub fn decompress(src List[u8], n int, exe int) List[u8]
    mut m := new_model(n, exe)
    mut pos := 0
    mut x := 0
    for _ in 0..4
        x = x.shl(8).bit_or(if pos < src.len() then src[pos].to_int() else 0)
        pos += 1
    mut x1 := 0
    mut x2 := 4294967295
    mut out := List[u8]()
    for _byte in 0..n
        for _bit in 0..8
            p := m.predict()
            xmid := x1 + (x2 - x1).shr(12) * p
            mut y := 0
            if x <= xmid
                y = 1
                x2 = xmid
            else
                x1 = xmid + 1
            m.update(y)
            while x1.bit_xor(x2).bit_and(4278190080) == 0
                x1 = x1.shl(8).bit_and(4294967295)
                x2 = x2.shl(8).bit_and(4294967295).bit_or(255)
                nb := if pos < src.len() then src[pos].to_int() else 0
                x = x.shl(8).bit_and(4294967295).bit_or(nb)
                pos += 1
        out.push(m.buf[m.buf.len() - 1])
    out

@test fn state_machine_is_closed_and_numbered()
    st := build_states()
    assert_eq(st.zeros.len(), NSTATES)
    assert_eq(st.nex.len(), NSTATES * 2)
    for x in st.nex
        assert(x >= 0 and x < NSTATES)
    # a run of ones climbs; a zero after it halves the ones
    mut s := 0
    for _ in 0..10
        s = st.nex[s * 2 + 1]
    assert_eq(st.ones[s], 10)
    s = st.nex[s * 2]
    assert_eq(st.ones[s], 6)
    assert_eq(st.zeros[s], 1)
    m := map_init(st)
    assert(m[s].shr(19) > 2048)
    assert(m[0].shr(19) == 2048)

@test fn roundtrips_text()
    mut d := List[u8]()
    for i in 0..3000
        d.push((97 + (i * i).bit_xor(i / 7) % 5).to_u8())
    c := compress(d, 0)
    assert(c.len() < d.len())
    assert_eq(decompress(c, d.len(), 0), d)
    assert_eq(decompress(compress(d, 1), d.len(), 1), d)

@test fn roundtrips_tiny()
    for n in 0..5
        d := [(200).to_u8() for _ in 0..n]
        assert_eq(decompress(compress(d, 0), n, 0), d)

@test fn roundtrips_words_and_binary()
    text := "the quick brown fox jumps over the lazy dog; The Quick Brown Fox! ".to_bytes()
    mut d := List[u8]()
    for i in 0..400
        for x in text
            d.push(x)
        d.push((i * 37).bit_and(255).to_u8())
    c := compress(d, 0)
    assert(c.len() * 4 < d.len())
    assert_eq(decompress(c, d.len(), 0), d)
