## Clove's max engine (engine 1): a bitwise context-mixing model with a
## long-range match model (the LZ part), two gated logistic mixers, two SSE
## stages and a carry-less arithmetic coder. Integer arithmetic only, so every
## machine produces and reads the same bytes.
##
## Per bit, eight hashed context models (orders 1-4 and 6, the current word,
## the word pair, and a sparse context that skips a byte), a direct order-0
## model and the match model each give a probability. Two mixers weigh their
## logits, one by the partial byte and one by the previous byte and the match
## state; two SSE stages refine the result by order-0 and order-1 context.
## Table sizes grow with the block (both sides know its length), so small
## blocks stay cheap.

NORD := 8
NIN := 11
LIMIT := 255
MASK31 := 2147483647
INIT := 1073741824

## squash/stretch as in the lpaq family: 12-bit probabilities, logits in -2047..2047.
SQ := [
    1,
    2,
    3,
    6,
    10,
    16,
    27,
    45,
    73,
    120,
    194,
    310,
    488,
    747,
    1101,
    1546,
    2047,
    2549,
    2994,
    3348,
    3607,
    3785,
    3901,
    3975,
    4022,
    4050,
    4068,
    4079,
    4085,
    4089,
    4092,
    4093,
    4094,
]

fn squash(d int) int
    if d > 2047
        return 4095
    if d < -2047
        return 0
    w := (d + 2048).bit_and(127)
    i := (d + 2048).shr(7)
    (SQ[i] * (128 - w) + SQ[i + 1] * w + 64).shr(7)

fn stretch_table() List[int]
    mut t := [0 for _ in 0..4096]
    mut pi := 0
    for x in -2047..2048
        v := squash(x)
        for i in pi..=v
            t[i] = x
        pi = v + 1
    t

fn delta_table() List[int]
    [131072 / (2 * n + 3) for n in 0..1024]

## Table slots hold a 21-bit probability over a 10-bit hit count; the count sets
## the learning rate (fast at first, then settling at 1/limit). See Model.adapt.

fn fold(x int) int
    x.bit_xor(x.shr(32)).bit_and(268435455)

fn bits_for(n int, lo int, hi int) int
    mut b := lo
    while b < hi and (1).shl(b) < n
        b += 1
    b

## The SSE curve of context `cx`: 33 points over the logit range.
fn apm_init(nctx int) List[int]
    curve := [squash((j - 16) * 128) * 16 for j in 0..33]
    [curve[k % 33] for k in 0..nctx * 33]

struct Model
    t List[int]
    tbits int
    o0 List[int]
    idx List[int]
    bkt List[int]
    hv List[int]
    st List[int]
    wa List[int]
    wb List[int]
    msm List[int]
    mtab List[int]
    mbits int
    a1 List[int]
    a2 List[int]
    buf List[u8]
    sq List[int]
    dt List[int]
    c0 int
    c4 int
    c8 int
    word0 int
    word1 int
    bitpos int
    mptr int
    mlen int
    mctx int
    sela int
    selb int
    dota int
    dotb int
    pmix int
    i1 int
    i2 int
    pr int

fn new_model(n int) Model
    tbits := bits_for(n * 2, 12, 21)
    mbits := bits_for(n, 10, 20)
    mut m := Model(
        t: [INIT.shl(31) + INIT for _ in 0..NORD * (1).shl(tbits - 1)],
        tbits: tbits,
        o0: [INIT for _ in 0..256],
        idx: [0 for _ in 0..NORD],
        bkt: [0 for _ in 0..NORD],
        hv: [0 for _ in 0..NORD],
        st: [0 for _ in 0..NIN],
        wa: [16000 for _ in 0..NIN * 256],
        wb: [16000 for _ in 0..NIN * 1024],
        msm: [INIT for _ in 0..64],
        mtab: [0 for _ in 0..(1).shl(mbits)],
        mbits: mbits,
        a1: apm_init(256),
        a2: apm_init(65536),
        buf: [],
        sq: stretch_table(),
        dt: delta_table(),
        c0: 1,
        c4: 0,
        c8: 0,
        word0: 0,
        word1: 0,
        bitpos: 0,
        mptr: 0,
        mlen: 0,
        mctx: 0,
        sela: 0,
        selb: 0,
        dota: 0,
        dotb: 0,
        pmix: 2048,
        i1: 0,
        i2: 0,
        pr: 2048,
    )
    m.set_idx()
    m

## Slot j of the hashed tables: two 31-bit slots share one int.
fn Model.slot(mut self, j int) int
    t[j.shr(1)].shr(31 * j.bit_and(1)).bit_and(MASK31)

fn Model.set_slot(mut self, j int, e int)
    sh := 31 * j.bit_and(1)
    w := j.shr(1)
    old := t[w].shr(sh).bit_and(MASK31)
    t[w] = t[w] - old.shl(sh) + e.shl(sh)

## Slots of the context models for the next bit. Each context hashes once per
## nibble to a bucket of 16 slots (8 ints, one cache line); the bits of the
## nibble so far pick the slot, so a byte costs two cache misses per context
## instead of eight.
fn Model.set_idx(mut self)
    if bitpos == 0 or bitpos == 4
        bmask := (1).shl(tbits - 4) - 1
        for i in 0..NORD
            bkt[i] = ((hv[i] + c0 * 40503) * 2654435761).shr(20).bit_and(bmask).shl(4)
                + i.shl(tbits)
    nib := if bitpos < 4 then c0 else (1).shl(bitpos - 4) + c0.bit_and((1).shl(bitpos - 4) - 1)
    for i in 0..NORD
        idx[i] = bkt[i] + nib

## SSE: interpolate the curve of context `cx` (stage 1 or 2) at p's logit.
fn Model.apm(mut self, stage int, cx int, p int) int
    s := sq[p] + 2048
    j := cx * 33 + s.shr(7)
    w := s.bit_and(127)
    if stage == 1
        return (a1[j] * (128 - w) + a1[j + 1] * w).shr(11)
    (a2[j] * (128 - w) + a2[j + 1] * w).shr(11)

fn Model.adapt(mut self, e int, y int, limit int) int
    n := e.bit_and(1023)
    p := e.shr(10)
    p2 := p + ((y.shl(21) - p) * dt[n]) / 65536
    n2 := if n < limit then n + 1 else n
    p2.shl(10) + n2

## The probability (12 bits) that the next bit is 1.
fn Model.predict(mut self) int
    st[0] = sq[o0[c0].shr(19)]
    for i in 0..NORD
        st[i + 1] = sq[slot(idx[i]).shr(19)]
    mut active := 0
    st[9] = 0
    mctx = -1
    if mlen > 0
        e := buf[mptr].to_int()
        if (e + 256).shr(8 - bitpos) == c0
            active = 1
            eb := e.shr(7 - bitpos).bit_and(1)
            lb := if mlen < 16 then mlen else 16 + ((mlen - 16) / 8).min(15)
            mctx = lb * 2 + eb
            st[9] = sq[msm[mctx].shr(19)]
    st[10] = 256
    mut mb := 0
    if active == 1
        mb = 3
        if mlen < 16
            mb = 1
        elif mlen < 32
            mb = 2
    sela = c0 * NIN
    selb = (c4.bit_and(255) + 256 * mb) * NIN
    mut da := 0
    mut db := 0
    for k in 0..NIN
        da += wa[sela + k] * st[k]
        db += wb[selb + k] * st[k]
    dota = (da / 65536).max(-2047).min(2047)
    dotb = (db / 65536).max(-2047).min(2047)
    pmix = squash((dota + dotb) / 2).max(1).min(4095)
    i1 = c0
    i2 = c0 + c4.bit_and(255).shl(8)
    p1 := apm(1, i1, pmix)
    p2 := apm(2, i2, pmix)
    pr = ((pmix + p1 + 2 * p2) / 4).max(1).min(4095)
    pr

fn Model.update(mut self, y int)
    ea := (y.shl(12) - squash(dota)) * 6
    eb := (y.shl(12) - squash(dotb)) * 6
    for k in 0..NIN
        wa[sela + k] += (st[k] * ea + 32768) / 65536
        wb[selb + k] += (st[k] * eb + 32768) / 65536
    s := sq[pmix] + 2048
    j0 := s.shr(7)
    near := if s.bit_and(127) < 64 then j0 else j0 + 1
    g := y.shl(16) + y.shl(7) - y - y
    j1 := i1 * 33 + near
    a1[j1] += (g - a1[j1]) / 128
    j2 := i2 * 33 + near
    a2[j2] += (g - a2[j2]) / 128
    e0 := adapt(o0[c0], y, LIMIT)
    o0[c0] = e0
    for i in 0..NORD
        j := idx[i]
        old := slot(j)
        upd := adapt(old, y, LIMIT)
        set_slot(j, upd)
    if mctx >= 0
        em := adapt(msm[mctx], y, 1023)
        msm[mctx] = em
    c0 = c0 * 2 + y
    bitpos += 1
    if bitpos == 8
        end_byte(c0 - 256)
        c0 = 1
        bitpos = 0
    set_idx()

fn Model.end_byte(mut self, b int)
    buf.push(b.to_u8())
    c8 = c8.shl(8).bit_and(4294967295).bit_or(c4.shr(24))
    c4 = c4.shl(8).bit_and(4294967295).bit_or(b)
    lower := if b >= 65 and b <= 90 then b + 32 else b
    if (lower >= 97 and lower <= 122) or b >= 128
        word0 = (word0 * 263 + lower).bit_and(1073741823)
    elif word0 != 0
        word1 = word0
        word0 = 0
    hv[0] = c4.bit_and(255) * 65599 + 1
    hv[1] = c4.bit_and(65535) * 31 + 2
    hv[2] = fold(c4.bit_and(16777215) * 2246822519) + 3
    hv[3] = fold(c4.shr(16) * 2246822519 + c4.bit_and(65535) * 3266489917) + 4
    hv[4] = fold(c4.bit_xor(c8.bit_and(65535) * 2654435761)) + 5
    hv[5] = fold(word0 * 2654435761) + 6
    hv[6] = fold(word0.bit_xor(word1 * 1000003) * 97) + 7
    hv[7] = fold(c4.shr(8).bit_and(65535) * 2246822519) + 8
    n := buf.len()
    if mlen > 0 and buf[mptr].to_int() == b
        mlen += 1
        mptr += 1
    else
        mlen = 0
    h := (fold(c4 + c8.bit_and(255).shl(32)) * 789008181).shr(20).bit_and((1).shl(mbits) - 1)
    if mlen == 0
        cand := mtab[h]
        if cand > 0
            mut k := 0
            while k < 32 and cand - 1 - k >= 0 and buf[cand - 1 - k] == buf[n - 1 - k]
                k += 1
            if k >= 5
                mlen = k
                mptr = cand
    mtab[h] = n

struct Coder
    out List[u8]
    x1 int
    x2 int

## Compresses `d` to a self-contained block.
pub fn compress(d List[u8]) List[u8]
    mut m := new_model(d.len())
    mut c := Coder(out: [], x1: 0, x2: 4294967295)
    for byte in d
        b := byte.to_int()
        mut i := 7
        while i >= 0
            y := b.shr(i).bit_and(1)
            p := m.predict()
            xmid := c.x1 + (c.x2 - c.x1).shr(12) * p
            if y == 1
                c.x2 = xmid
            else
                c.x1 = xmid + 1
            m.update(y)
            while c.x1.bit_xor(c.x2).bit_and(4278190080) == 0
                c.out.push(c.x2.shr(24).to_u8())
                c.x1 = c.x1.shl(8).bit_and(4294967295)
                c.x2 = c.x2.shl(8).bit_and(4294967295).bit_or(255)
            i -= 1
    c.out.push(c.x1.shr(24).to_u8())
    c.out.push(c.x1.shr(16).bit_and(255).to_u8())
    c.out.push(c.x1.shr(8).bit_and(255).to_u8())
    c.out.push(c.x1.bit_and(255).to_u8())
    c.out

## Decodes `n` bytes. A damaged block gives wrong bytes, which the caller's CRC catches.
pub fn decompress(src List[u8], n int) List[u8]
    mut m := new_model(n)
    mut pos := 0
    mut x := 0
    for _ in 0..4
        x = x.shl(8).bit_or(if pos < src.len() then src[pos].to_int() else 0)
        pos += 1
    mut x1 := 0
    mut x2 := 4294967295
    mut out := List[u8]()
    for _byte in 0..n
        for _bit in 0..8
            p := m.predict()
            xmid := x1 + (x2 - x1).shr(12) * p
            mut y := 0
            if x <= xmid
                y = 1
                x2 = xmid
            else
                x1 = xmid + 1
            m.update(y)
            while x1.bit_xor(x2).bit_and(4278190080) == 0
                x1 = x1.shl(8).bit_and(4294967295)
                x2 = x2.shl(8).bit_and(4294967295).bit_or(255)
                nb := if pos < src.len() then src[pos].to_int() else 0
                x = x.shl(8).bit_and(4294967295).bit_or(nb)
                pos += 1
        out.push(m.buf[m.buf.len() - 1])
    out

@test fn roundtrips_text()
    mut d := List[u8]()
    for i in 0..3000
        d.push((97 + (i * i).bit_xor(i / 7) % 5).to_u8())
    c := compress(d)
    assert(c.len() < d.len())
    assert_eq(decompress(c, d.len()), d)

@test fn roundtrips_tiny()
    for n in 0..5
        d := [(200).to_u8() for _ in 0..n]
        assert_eq(decompress(compress(d), n), d)

@test fn roundtrips_words_and_binary()
    text := "the quick brown fox jumps over the lazy dog; The Quick Brown Fox! ".to_bytes()
    mut d := List[u8]()
    for i in 0..400
        for x in text
            d.push(x)
        d.push((i * 37).bit_and(255).to_u8())
    c := compress(d)
    assert(c.len() * 4 < d.len())
    assert_eq(decompress(c, d.len()), d)
