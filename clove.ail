## clove: an archiver written in AIL, with its own codecs: a fast LZ engine (lz/) and a
## context-mixing engine (cm/), chosen per block.
##
##     clove.ail a [-m fast|max] [-b BLOCK_KB] ARCHIVE PATH...   add files and directories
##     clove.ail x ARCHIVE [DIR]                        extract (into DIR, default .)
##     clove.ail l [--json] ARCHIVE                     list
##     clove.ail t [--json] ARCHIVE                     test: decode every block, check CRCs
##     clove.ail read ARCHIVE FILE [--range A:B] [--out PATH]
##                                                      bytes A..B of one file, decoding only the blocks it needs
##     clove.ail grep [--json] [-i] [-a] [--max N] [--file NAME] ARCHIVE TEXT
##                                                      lines holding TEXT; the trigram index skips blocks that cannot match
##     clove.ail describe [--json] ARCHIVE              files, kinds, line counts, engines and the index
##     clove.ail serve                                  MCP server on stdin and stdout: list, describe, read, grep
##     clove.ail bench FILE [-m fast|max] [-b BLOCK_KB]          ratio and speed, with a round-trip check
##
## Blocks are independent: they compress and decode on all cores (`par for`),
## and the index at the front of the archive finds any block with no scan.
## Format: README.md. Errors carry a rule ID (`clove.format`, `clove.usage`).

use cm
use exe
use lz
use search

MAGIC := b"CLV2"
BATCH := 8
BLOCK_FAST := 1048576
BLOCK_MAX := 4194304
MAX_BLOCK := 1073741824
MAX_SIZE := 281474976710656

USAGE := """
    usage: clove COMMAND ...
      a [-m fast|max] [-b BLOCK_KB] ARCHIVE PATH...   add (fast: LZ, 1 MB blocks; max: context mixing, 4 MB blocks)
      x ARCHIVE [DIR]                   extract into DIR (default .)
      l [--json] ARCHIVE                list
      t [--json] ARCHIVE                test every block
      read ARCHIVE FILE [--range A:B] [--out PATH]
                                        part of one file; only the blocks it needs are decoded
      grep [--json] [-i] [-a] [--max N] [--file NAME] ARCHIVE TEXT
                                        lines holding TEXT, decoding only blocks the index lets through
      describe [--json] ARCHIVE         files, kinds, line counts, engines, index size
      serve                             MCP server on stdin/stdout (tools clove_list, clove_describe, clove_read, clove_grep)
      bench FILE [-m fast|max] [-b BLOCK_KB]   ratio, speed and round-trip check
    """

error enum CloveError
    Usage(text str) "error[clove.usage]: {text}"
    Bad(why str) "error[clove.format]: bad archive: {why}"

struct FileEnt
    name str
    size int
    first int
    nb int

struct Archive
    bsize int
    files List[FileEnt]
    offs List[int]
    clens List[int]
    crcs List[int]
    engines List[int]

struct Packed
    data bytes
    clens List[int]
    crcs List[int]
    engines List[int]

fn to_ints(b bytes) List[int]
    mut out := List[int]()
    for x in b
        out.push(x.to_int())
    out

fn to_bytes(xs List[int]) bytes
    bytes.from_list([x.to_u8() for x in xs])

fn put(mut out List[int], v int, nbytes int)
    for i in 0..nbytes
        out.push(v.shr(8 * i).bit_and(255))

fn rd(b bytes, pos int, nbytes int) int ! CloveError
    if pos + nbytes > b.len()
        return Bad(why: "truncated at byte {pos}")
    mut v := 0
    for i in 0..nbytes
        v += b[pos + i].to_int().shl(8 * i)
    v

fn nblocks(size int, bsize int) int
    (size + bsize - 1) / bsize

fn raw_len(size int, bsize int, i int) int
    bsize.min(size - i * bsize)

## Compresses `data` block by block (a block that does not shrink is stored).
## The engine byte: the codec in the low 4 bits (0 stored, 1 cm, 2 lz) and the
## executable filter in the next 2 (0 none, 1 x86-64, 2 ARM64; never on stored blocks).
fn pack(data bytes, bsize int, engine int) Packed
    nb := nblocks(data.len(), bsize)
    kind := exe.detect(data)
    mut parts := [List[u8]() for _ in 0..nb]
    mut crcs := [0 for _ in 0..nb]
    mut all := b""
    mut first := 0
    while first < nb
        last := (first + BATCH).min(nb)
        par for i in first..last
            s := i * bsize
            raw := data[s..(s + bsize).min(data.len())]
            crcs[i] = hash.crc32(raw)
            blk := raw.to_list()
            src := if kind == 0 then blk else exe.filter(blk, kind, true)
            c := if engine == 1 then cm.compress(src) else lz.compress(src, 5)
            parts[i] = if c.len() < blk.len() then c else blk
        for i in first..last
            all = all + bytes.from_list(parts[i])
        first = last
    clens := [q.len() for q in parts]
    engines := [
        if clens[i] == raw_len(data.len(), bsize, i) then 0 else engine + kind.shl(4)
        for i in 0..nb
    ]
    Packed(data: all, clens: clens, crcs: crcs, engines: engines)

## Decodes blocks `first..last` (positions in the arrays) on all cores; a block that
## fails its length or CRC check comes back empty.
fn decode(
    data bytes,
    offs List[int],
    clens List[int],
    engines List[int],
    crcs List[int],
    rawlens List[int],
    first int,
    last int,
) List[List[u8]]
    mut out := [List[u8]() for _ in 0..clens.len()]
    par for i in first..last
        comp := data[offs[i]..offs[i] + clens[i]].to_list()
        kind := engines[i].shr(4)
        dec := match engines[i].bit_and(15)
            0 => comp
            1 => cm.decompress(comp, rawlens[i])
            _ => lz.decompress(comp, rawlens[i])
        raw := if kind == 0 then dec else exe.filter(dec, kind, false)
        ok := raw.len() == rawlens[i] and hash.crc32(bytes.from_list(raw)) == crcs[i]
        out[i] = if ok then raw else List[u8]()
    out

## Decodes and checks the given blocks, batch by batch on all cores; unless dest is "",
## the data is appended to dest.
fn unpack(
    name str,
    data bytes,
    offs List[int],
    clens List[int],
    engines List[int],
    crcs List[int],
    rawlens List[int],
    dest str,
) ! CloveError | fs.IoError
    if dest != ""
        fs.write_bytes(dest, b"")?
    mut first := 0
    while first < clens.len()
        last := (first + BATCH).min(clens.len())
        out := decode(data, offs, clens, engines, crcs, rawlens, first, last)
        for i in first..last
            if out[i].len() != rawlens[i]
                return Bad(why: "{name}: block {i} is damaged")
            if dest != ""
                fs.append_bytes(dest, bytes.from_list(out[i]))?
        first = last

## Reads and validates the index. Every field is range-checked before use, so a
## damaged archive gives a `clove.format` error, never a trap.
fn parse_archive(b bytes, path str) Archive ! CloveError
    if b.len() < 16 or b[0..4] != MAGIC
        return Bad(why: "{path} is not a CLV2 archive")
    nfiles := rd(b, 4, 4)?
    nblk := rd(b, 8, 4)?
    bsize := rd(b, 12, 4)?
    if bsize < 4096 or bsize > MAX_BLOCK
        return Bad(why: "block size {bsize} is outside 4 KB..1 GB")
    if 16 + nfiles * 18 + nblk * 17 > b.len()
        return Bad(why: "index claims {nfiles} files and {nblk} blocks, more than the archive holds")
    mut p := 16
    mut files := List[FileEnt]()
    mut total := 0
    for _ in 0..nfiles
        nlen := rd(b, p, 2)?
        if p + 18 + nlen > b.len()
            return Bad(why: "truncated file entry at byte {p}")
        name := b[p + 2..p + 2 + nlen].to_str() else return Bad(why: "file name at byte {p} is not UTF-8")
        size := rd(b, p + 2 + nlen, 8)?
        first := rd(b, p + 10 + nlen, 4)?
        nb := rd(b, p + 14 + nlen, 4)?
        if size > MAX_SIZE
            return Bad(why: "{name}: declared size {size} is too large")
        if first != total or nb != nblocks(size, bsize) or total + nb > nblk
            return Bad(why: "{name}: block range")
        files.push(FileEnt(name: name, size: size, first: first, nb: nb))
        total += nb
        p += 18 + nlen
    if total != nblk
        return Bad(why: "files cover {total} blocks, the index has {nblk}")
    if p + nblk * 17 > b.len()
        return Bad(why: "truncated block index")
    dstart := p + nblk * 17
    mut offs := List[int]()
    mut clens := List[int]()
    mut crcs := List[int]()
    mut engines := List[int]()
    mut next := 0
    for f in files
        for k in 0..f.nb
            rel := rd(b, p, 8)?
            clen := rd(b, p + 8, 4)?
            eng := rd(b, p + 16, 1)?
            raw := raw_len(f.size, bsize, k)
            if rel != next
                return Bad(why: "{f.name}: block {k} is not where the index says")
            codec := eng.bit_and(15)
            if codec > 2
                or eng.shr(4) > 2
                or (codec == 0 and eng != 0)
                or clen < 1
                or clen > raw
                or (codec == 0) != (clen == raw)
                return Bad(why: "{f.name}: block {k} has engine {eng} and length {clen} for {raw} bytes")
            if dstart + rel + clen > b.len()
                return Bad(why: "{f.name}: block {k} runs past the end of the archive")
            offs.push(dstart + rel)
            clens.push(clen)
            crcs.push(rd(b, p + 12, 4)?)
            engines.push(eng)
            next += clen
            p += 17
    Archive(bsize: bsize, files: files, offs: offs, clens: clens, crcs: crcs, engines: engines)

## The arrays of one file's blocks, so `unpack` and `read` can work on a slice.
fn slice(xs List[int], first int, nb int) List[int]
    xs[first..first + nb]

fn file_rawlens(a Archive, f FileEnt) List[int]
    [raw_len(f.size, a.bsize, i) for i in 0..f.nb]

fn header_bytes(bsize int, files List[FileEnt], p Packed) bytes
    mut h := List[int]()
    h.extend([67, 76, 86, 50])
    put(mut h, files.len(), 4)
    put(mut h, p.clens.len(), 4)
    put(mut h, bsize, 4)
    for f in files
        nbytes := f.name.to_bytes()
        put(mut h, nbytes.len(), 2)
        h.extend(to_ints(nbytes))
        put(mut h, f.size, 8)
        put(mut h, f.first, 4)
        put(mut h, f.nb, 4)
    mut off := 0
    for i in 0..p.clens.len()
        put(mut h, off, 8)
        put(mut h, p.clens[i], 4)
        put(mut h, p.crcs[i], 4)
        put(mut h, p.engines[i], 1)
        off += p.clens[i]
    to_bytes(h)

fn collect(paths List[str]) List[str] ! fs.IoError
    mut files := List[str]()
    for p in paths
        if fs.metadata(p)?.is_dir
            for f in fs.walk(p)?.sorted()
                files.push(f)
        else
            files.push(p)
    files

## A stored name may only name a path inside the extraction directory, on every
## platform: relative, "/"-separated, no "." or ".." or empty parts, no
## backslash (Windows separator), no ":" (drive letters, streams), no control
## characters.
fn safe(name str) bool
    if name == "" or name.starts_with("/") or name.contains(":") or name.contains("\\")
        return false
    for c in name.chars()
        if c.code() < 32
            return false
    for part in name.split("/")
        if part == "" or part == "." or part == ".."
            return false
    true

## Names are stored relative, as 7-Zip does: backslashes become "/", and a
## leading "/" or "./" is dropped.
fn stored_name(path str) str
    mut s := path.replace("\\", "/")
    while s.starts_with("/") or s.starts_with("./")
        s = s.slice(if s.starts_with("/") then 1 else 2, s.len())
    s

## The trailer entries of one file's blocks, one block per core.
fn index_file(data bytes, bsize int) List[int]
    nb := nblocks(data.len(), bsize)
    mut parts := [List[int]() for _ in 0..nb]
    par for i in 0..nb
        parts[i] = search.entry(data, i * bsize, (i * bsize + bsize).min(data.len()))
    mut all := List[int]()
    for p in parts
        all.extend(p)
    all

fn cmd_add(archive str, paths List[str], bsize int, engine int) ! CloveError | fs.IoError
    files := collect(paths)?
    tmp := "{archive}.tmp"
    fs.write_bytes(tmp, b"")?
    mut ents := List[FileEnt]()
    mut all := Packed(data: b"", clens: [], crcs: [], engines: [])
    mut total := 0
    mut foot := List[int]()
    for f in files
        name := stored_name(f)
        if not safe(name)
            return Usage(text: "refusing the name {f}")
        data := fs.read_bytes(f)?
        p := pack(data, bsize, engine)
        ents.push(FileEnt(name: name, size: data.len(), first: all.clens.len(), nb: p.clens.len()))
        all.clens.extend(p.clens)
        all.crcs.extend(p.crcs)
        all.engines.extend(p.engines)
        fs.append_bytes(tmp, p.data)?
        foot.extend(index_file(data, bsize))
        total += data.len()
        print("{f}  {data.len()}")
    fs.write_bytes(archive, header_bytes(bsize, ents, all))?
    fs.append_bytes(archive, fs.read_bytes(tmp)?)?
    fs.append_bytes(archive, to_bytes(search.trailer(foot)))?
    fs.remove(tmp)?
    print("{files.len()} files, {total} -> {fs.metadata(archive)?.size} bytes")

fn cmd_extract(archive str, dir str) ! CloveError | fs.IoError
    b := fs.read_bytes(archive)?
    a := parse_archive(b, archive)?
    for f in a.files
        if not safe(f.name)
            return Bad(why: "unsafe name {f.name}")
        dest := if dir == "." then f.name else "{dir}/{f.name}"
        parts := dest.split("/")
        if parts.len() > 1
            fs.make_dir(parts[0..parts.len() - 1].join("/"))?
        unpack(
            f.name,
            b,
            slice(a.offs, f.first, f.nb),
            slice(a.clens, f.first, f.nb),
            slice(a.engines, f.first, f.nb),
            slice(a.crcs, f.first, f.nb),
            file_rawlens(a, f),
            dest,
        )?
        print("{f.name}")

fn packed_of(a Archive, f FileEnt) int
    mut c := 0
    for x in slice(a.clens, f.first, f.nb)
        c += x
    c

## A JSON string literal, quotes included.
fn js(s str) str
    Json.Str(s).to_text()

fn list_json(archive str) str ! CloveError | fs.IoError
    b := fs.read_bytes(archive)?
    a := parse_archive(b, archive)?
    mut size := 0
    mut packed := 0
    mut items := List[str]()
    for f in a.files
        c := packed_of(a, f)
        items.push("\{\"name\": {js(f.name)}, \"size\": {f.size}, \"packed\": {c}, \"blocks\": {f.nb}}")
        size += f.size
        packed += c
    "\{\"archive\": {js(archive)}, \"block_size\": {a.bsize}, \"files\": [{items.join(", ")}], \"size\": {size}, \"packed\": {packed}}"

fn cmd_list(archive str, json bool) ! CloveError | fs.IoError
    if json
        print(list_json(archive)?)
        return
    b := fs.read_bytes(archive)?
    a := parse_archive(b, archive)?
    mut size := 0
    mut packed := 0
    for f in a.files
        c := packed_of(a, f)
        print("{f.size:>12} {c:>12}  {f.name}")
        size += f.size
        packed += c
    print("{size:>12} {packed:>12}  {a.files.len()} files")

fn cmd_test(archive str, json bool) ! CloveError | fs.IoError
    b := fs.read_bytes(archive)?
    a := parse_archive(b, archive)?
    for f in a.files
        unpack(
            f.name,
            b,
            slice(a.offs, f.first, f.nb),
            slice(a.clens, f.first, f.nb),
            slice(a.engines, f.first, f.nb),
            slice(a.crcs, f.first, f.nb),
            file_rawlens(a, f),
            "",
        )?
    if json
        print("\{\"ok\": true, \"files\": {a.files.len()}}")
    else
        print("ok: {a.files.len()} files")

## Bytes lo..hi of one file; only the blocks that cover them are decoded.
fn read_part(archive str, name str, lo int, hi int) bytes ! CloveError | fs.IoError
    b := fs.read_bytes(archive)?
    a := parse_archive(b, archive)?
    mut found := -1
    for i in 0..a.files.len()
        if a.files[i].name == name
            found = i
    if found < 0
        return Usage(text: "{name} is not in {archive}")
    f := a.files[found]
    end := if hi < 0 then f.size else hi.min(f.size)
    if lo < 0 or lo > end
        return Usage(text: "range {lo}:{end} is outside {name} ({f.size} bytes)")
    if lo == end
        return b""
    b0 := lo / a.bsize
    b1 := (end - 1) / a.bsize + 1
    g0 := f.first + b0
    cnt := b1 - b0
    rawlens := [raw_len(f.size, a.bsize, b0 + i) for i in 0..cnt]
    got := decode(
        b,
        slice(a.offs, g0, cnt),
        slice(a.clens, g0, cnt),
        slice(a.engines, g0, cnt),
        slice(a.crcs, g0, cnt),
        rawlens,
        0,
        cnt,
    )
    mut buf := List[u8]()
    for i in 0..cnt
        if got[i].len() != rawlens[i]
            return Bad(why: "{name}: block {b0 + i} is damaged")
        buf.extend(got[i])
    bytes.from_list(buf[lo - b0 * a.bsize..end - b0 * a.bsize])

fn cmd_read(archive str, name str, lo int, hi int, out str) ! CloveError | fs.IoError
    part := read_part(archive, name, lo, hi)?
    if out == ""
        print(part.text())
    else
        fs.write_bytes(out, part)?

CHUNK := 32
HITTEXT := 512

struct Hit
    file str
    line int
    offset int
    text str

struct Found
    hits List[Hit]
    truncated bool
    indexed bool
    blocks int
    decoded int
    skipped int

## Lines of `pat` in the archive's files. With the trigram trailer, only blocks whose filter
## can hold the text are decoded (plus the next block of a candidate, for a match that
## crosses the boundary); without it every block is.
fn run_grep(
    archive str,
    pat str,
    fold bool,
    binary bool,
    max int,
    only str,
) Found ! CloveError | fs.IoError
    b := fs.read_bytes(archive)?
    a := parse_archive(b, archive)?
    pb := pat.to_bytes()
    if pb.len() == 0
        return Usage(text: "grep needs text to look for")
    if pb.len() > a.bsize
        return Usage(text: "the text is longer than the block ({a.bsize} bytes)")
    ix := search.load(b, a.offs.len())
    mut r := Found(hits: [], truncated: false, indexed: ix.ok, blocks: 0, decoded: 0, skipped: 0)
    for f in a.files
        if only != "" and f.name != only
            continue
        r.blocks += f.nb
        mut cands := [j for j in 0..f.nb]
        mut pre := [0 for _ in 0..f.nb]
        if ix.ok
            cands = search.candidates(ix, b, f.first, f.nb, pb, binary)
            if not binary
                for j in 0..f.nb
                    if ix.text[f.first + j] == 0
                        r.skipped += 1
            for j in 1..f.nb
                pre[j] = pre[j - 1] + ix.nl[f.first + j - 1]
        mut running := 0
        mut c0 := 0
        while c0 < cands.len() and not r.truncated
            c1 := (c0 + CHUNK).min(cands.len())
            mut need := List[int]()
            for j in cands[c0..c1]
                if need.len() == 0 or need[need.len() - 1] < j
                    need.push(j)
                if j + 1 < f.nb
                    need.push(j + 1)
            mut at := [-1 for _ in 0..f.nb]
            for t in 0..need.len()
                at[need[t]] = t
            rl := [raw_len(f.size, a.bsize, j) for j in need]
            got := decode(
                b,
                [a.offs[f.first + j] for j in need],
                [a.clens[f.first + j] for j in need],
                [a.engines[f.first + j] for j in need],
                [a.crcs[f.first + j] for j in need],
                rl,
                0,
                need.len(),
            )
            r.decoded += need.len()
            for t in 0..need.len()
                if got[t].len() != rl[t]
                    return Bad(why: "{f.name}: block {need[t]} is damaged")
            for j in cands[c0..c1]
                own := bytes.from_list(got[at[j]])
                buf := if j + 1 < f.nb then own + bytes.from_list(got[at[j + 1]]) else own
                before := if ix.ok then pre[j] else running
                for p in search.scan(buf, own.len(), pb, fold)
                    if r.hits.len() >= max
                        r.truncated = true
                        break
                    s := search.line_start(buf, p)
                    w := (p - HITTEXT / 4).max(s)
                    e := search.line_end(buf, p).min(w + HITTEXT)
                    r.hits.push(Hit(
                        file: f.name,
                        line: before + search.newlines(buf, s) + 1,
                        offset: j * a.bsize + p,
                        text: buf[w..e].text(),
                    ))
                running += search.newlines(own, own.len())
                if r.truncated
                    break
            c0 = c1
        if r.truncated
            break
    r

fn grep_json(r Found, archive str, pat str) str
    items := [
        "\{\"file\": {js(h.file)}, \"line\": {h.line}, \"offset\": {h.offset}, \"text\": {js(h.text)}}"
        for h in r.hits
    ]
    "\{\"archive\": {js(archive)}, \"pattern\": {js(pat)}, \"hits\": [{items.join(", ")}], \"truncated\": {r.truncated}, \"indexed\": {r.indexed}, \"blocks\": {r.blocks}, \"decoded\": {r.decoded}, \"skipped_binary\": {r.skipped}}"

fn cmd_grep(archive str, pat str, o Opts) ! CloveError | fs.IoError
    r := run_grep(archive, pat, o.fold, o.binary, o.max, o.only)?
    if o.json
        print(grep_json(r, archive, pat))
        return
    for h in r.hits
        print("{h.file}:{h.line}:{h.text}")
    if r.truncated
        io.eprint("clove: stopped at {o.max} lines (--max N for more)")

fn kind_of(ix search.Index, f FileEnt) str
    if not ix.ok or f.nb == 0
        return "unknown"
    mut text := 0
    for j in 0..f.nb
        text += ix.text[f.first + j]
    if text == f.nb
        return "text"
    if text == 0
        return "binary"
    "mixed"

## One JSON object that tells an agent what is inside before it reads anything.
fn describe_json(archive str) str ! CloveError | fs.IoError
    b := fs.read_bytes(archive)?
    a := parse_archive(b, archive)?
    ix := search.load(b, a.offs.len())
    mut items := List[str]()
    mut size := 0
    mut packed := 0
    for f in a.files
        mut nl := 0
        mut cm_blocks := 0
        mut lz_blocks := 0
        mut stored := 0
        for j in 0..f.nb
            if ix.ok
                nl += ix.nl[f.first + j]
            match a.engines[f.first + j].bit_and(15)
                0 => stored += 1
                1 => cm_blocks += 1
                _ => lz_blocks += 1
        c := packed_of(a, f)
        size += f.size
        packed += c
        items.push("\{\"name\": {js(f.name)}, \"size\": {f.size}, \"packed\": {c}, \"blocks\": {f.nb}, \"kind\": \"{kind_of(ix, f)}\", \"newlines\": {nl}, \"engines\": \{\"stored\": {stored}, \"cm\": {cm_blocks}, \"lz\": {lz_blocks}}}")
    mut index_bytes := 0
    if ix.ok
        for k in ix.ks
            index_bytes += 6 + search.pow2(k) / 8
        index_bytes += 8
    "\{\"archive\": {js(archive)}, \"block_size\": {a.bsize}, \"files\": [{items.join(", ")}], \"size\": {size}, \"packed\": {packed}, \"blocks\": {a.offs.len()}, \"index\": \{\"trigram\": {ix.ok}, \"bytes\": {index_bytes}}}"

fn cmd_describe(archive str, json bool) ! CloveError | fs.IoError
    if json
        print(describe_json(archive)?)
        return
    b := fs.read_bytes(archive)?
    a := parse_archive(b, archive)?
    ix := search.load(b, a.offs.len())
    for f in a.files
        mut nl := 0
        for j in 0..f.nb
            if ix.ok
                nl += ix.nl[f.first + j]
        print("{f.size:>12} {packed_of(a, f):>12} {kind_of(ix, f):<8} {nl:>9} lines  {f.name}")
    print("{a.files.len()} files, {a.offs.len()} blocks of {a.bsize} bytes, trigram index: {if ix.ok then "yes" else "no"}")

fn prop(name str, kind str) str
    "{js(name)}: \{\"type\": {js(kind)}}"

fn tool(name str, desc str, props List[str], required List[str]) str
    req := [js(r) for r in required]
    "\{\"name\": {js(name)}, \"description\": {js(desc)}, \"inputSchema\": \{\"type\": \"object\", \"properties\": \{{props.join(", ")}}, \"required\": [{req.join(", ")}]}}"

fn tools_json() str
    ar := prop("archive", "string")
    list := tool(
        "clove_list",
        "List the files in a Clove archive with sizes and block counts.",
        [ar],
        ["archive"],
    )
    desc := tool(
        "clove_describe",
        "Describe a Clove archive: each file's kind (text, binary, mixed), newline count, codecs and the trigram index. Reads only the index.",
        [ar],
        ["archive"],
    )
    read := tool(
        "clove_read",
        "Read bytes start..end of one file, decoding only the blocks that hold them. Output is capped at 65536 bytes.",
        [ar, prop("file", "string"), prop("start", "integer"), prop("end", "integer")],
        ["archive", "file"],
    )
    grep := tool(
        "clove_grep",
        "Find lines containing a literal string without extracting the archive; the trigram index skips blocks that cannot match. Returns file, line, byte offset and text.",
        [
            ar,
            prop("pattern", "string"),
            prop("ignore_case", "boolean"),
            prop("binary", "boolean"),
            prop("max", "integer"),
            prop("file", "string"),
        ],
        ["archive", "pattern"],
    )
    "[{[list, desc, read, grep].join(", ")}]"

SERVE_CAP := 65536

fn call_tool(name str, args Json) str ! CloveError | fs.IoError
    archive := args.text("archive", "")
    if archive == ""
        return Usage(text: "{name} needs an archive")
    match name
        "clove_list" => list_json(archive)?
        "clove_describe" => describe_json(archive)?
        "clove_read" =>
            lo := (args.get("start")?.as_num() else 0.0).to_int()
            hi := (args.get("end")?.as_num() else -1.0).to_int()
            file := args.text("file", "")
            part := read_part(
                archive,
                file,
                lo,
                if hi < 0 then lo + SERVE_CAP else hi.min(lo + SERVE_CAP),
            )?
            part.text()
        "clove_grep" =>
            pat := args.text("pattern", "")
            max := (args.get("max")?.as_num() else 200.0).to_int()
            r := run_grep(
                archive,
                pat,
                args.flag("ignore_case", false),
                args.flag("binary", false),
                max,
                args.text("file", ""),
            )?
            grep_json(r, archive, pat)
        _ => return Usage(text: "unknown tool {name}")

fn reply(id str, body str)
    print("\{\"jsonrpc\": \"2.0\", \"id\": {id}, {body}}")

## MCP over stdio: one JSON-RPC message per line.
fn cmd_serve()
    while true
        line := io.read_line() else break
        if line.trim() == ""
            continue
        msg := parse_json(line) else err
            reply("null", "\"error\": \{\"code\": -32700, \"message\": \"parse error\"}")
            continue
        mut id := ""
        if i := msg.get("id")
            id = i.to_text()
        method := msg.text("method", "")
        if id == ""
            continue
        match method
            "initialize" => reply(
                id,
                "\"result\": \{\"protocolVersion\": \"2024-11-05\", \"capabilities\": \{\"tools\": \{}}, \"serverInfo\": \{\"name\": \"clove\", \"version\": \"0.1\"}}",
            )
            "tools/list" => reply(id, "\"result\": \{\"tools\": {tools_json()}}")
            "tools/call" =>
                params := msg.get("params") else Json.Obj([])
                args := params.get("arguments") else Json.Obj([])
                out := call_tool(params.text("name", ""), args) else err
                    reply(
                        id,
                        "\"result\": \{\"content\": [\{\"type\": \"text\", \"text\": {js("{err}")}}], \"isError\": true}",
                    )
                    continue
                reply(
                    id,
                    "\"result\": \{\"content\": [\{\"type\": \"text\", \"text\": {js(out)}}], \"isError\": false}",
                )
            "ping" => reply(id, "\"result\": \{}")
            _ => reply(id, "\"error\": \{\"code\": -32601, \"message\": \"method not found\"}")

fn mb_per_s(n int, ms int) str
    if ms <= 0
        return "-"
    mbs := n.to_float() / 1048576.0 / (ms.to_float() / 1000.0)
    "{mbs:.2}"

fn cmd_bench(path str, bsize int, engine int) ! CloveError | fs.IoError
    data := fs.read_bytes(path)?
    t0 := time.now_ms()
    p := pack(data, bsize, engine)
    t1 := time.now_ms()
    nb := p.clens.len()
    mut offs := List[int]()
    mut o := 0
    for c in p.clens
        offs.push(o)
        o += c
    unpack(
        path,
        p.data,
        offs,
        p.clens,
        p.engines,
        p.crcs,
        [raw_len(data.len(), bsize, i) for i in 0..nb],
        "",
    )?
    t2 := time.now_ms()
    ratio := data.len().to_float() / p.data.len().max(1).to_float()
    print("{path}: {data.len()} -> {p.data.len()} bytes, ratio {ratio:.3}")
    print("compress   {t1 - t0} ms  {mb_per_s(data.len(), t1 - t0)} MB/s")
    print("decompress {t2 - t1} ms  {mb_per_s(data.len(), t2 - t1)} MB/s")
    print("verified: every block decoded and matched its CRC")

struct Opts
    bsize int
    engine int
    json bool
    lo int
    hi int
    out str
    fold bool
    binary bool
    max int
    only str
    words List[str]

fn parse(args List[str]) Opts ! CloveError
    mut o := Opts(
        bsize: 0,
        engine: 2,
        json: false,
        lo: 0,
        hi: -1,
        out: "",
        fold: false,
        binary: false,
        max: 200,
        only: "",
        words: [],
    )
    mut i := 0
    while i < args.len()
        a := args[i]
        word := if i + 1 < args.len() then args[i + 1] else ""
        if a == "-b"
            n := word.to_int() else return Usage(text: "-b needs a number of KB")
            o.bsize = n * 1024
            i += 2
        elif a == "-m"
            if word == "fast"
                o.engine = 2
            elif word == "max"
                o.engine = 1
            else
                return Usage(text: "-m is fast or max")
            i += 2
        elif a == "--json"
            o.json = true
            i += 1
        elif a == "--out"
            o.out = word
            i += 2
        elif a == "-i"
            o.fold = true
            i += 1
        elif a == "-a"
            o.binary = true
            i += 1
        elif a == "--max"
            o.max = word.to_int() else return Usage(text: "--max needs a number")
            i += 2
        elif a == "--file"
            o.only = word
            i += 2
        elif a == "--range"
            ends := word.split(":")
            if ends.len() != 2
                return Usage(text: "--range needs A:B")
            o.lo = ends[0].to_int() else return Usage(text: "--range needs numbers")
            o.hi = -1
            if ends[1] != ""
                o.hi = ends[1].to_int() else return Usage(text: "--range needs numbers")
            i += 2
        else
            o.words.push(a)
            i += 1
    if o.bsize == 0
        o.bsize = if o.engine == 1 then BLOCK_MAX else BLOCK_FAST
    if o.bsize < 4096 or o.bsize > MAX_BLOCK
        return Usage(text: "the block is 4 KB to 1 GB")
    o

fn require(w List[str], n int, what str) ! CloveError
    if w.len() < n
        return Usage(text: what)

fn main() !
    args := env.args()
    if args.len() < 1
        print(USAGE)
        return
    o := parse(args[1..])?
    w := o.words
    match args[0]
        "a" =>
            require(w, 2, "a needs ARCHIVE and PATH...")?
            cmd_add(w[0], w[1..], o.bsize, o.engine)?
        "x" =>
            require(w, 1, "x needs ARCHIVE")?
            cmd_extract(w[0], if w.len() > 1 then w[1] else ".")?
        "l" =>
            require(w, 1, "l needs ARCHIVE")?
            cmd_list(w[0], o.json)?
        "t" =>
            require(w, 1, "t needs ARCHIVE")?
            cmd_test(w[0], o.json)?
        "read" =>
            require(w, 2, "read needs ARCHIVE and FILE")?
            cmd_read(w[0], w[1], o.lo, o.hi, o.out)?
        "grep" =>
            require(w, 2, "grep needs ARCHIVE and TEXT")?
            cmd_grep(w[0], w[1], o)?
        "describe" =>
            require(w, 1, "describe needs ARCHIVE")?
            cmd_describe(w[0], o.json)?
        "serve" => cmd_serve()
        "bench" =>
            require(w, 1, "bench needs FILE")?
            cmd_bench(w[0], o.bsize, o.engine)?
        _ => print(USAGE)

## Archive-level tests. They write under target/clove-test (git-ignored).

TEST_DIR := "target/clove-test"

fn test_bytes(n int, seed int) bytes
    mut xs := List[u8]()
    mut x := seed
    for i in 0..n
        x = (x * 1103515245 + 12345).bit_and(2147483647)
        v := if i % 3 == 0 then x.shr(16).bit_and(255) else 97 + (i / 7) % 13
        xs.push(v.to_u8())
    bytes.from_list(xs)

fn make_tree(root str) ! fs.IoError
    fs.make_dir("{root}/src/deep/er")?
    fs.write_bytes("{root}/empty.txt", b"")?
    fs.write_bytes("{root}/src/one.txt", "hello clove\n".to_bytes())?
    fs.write_bytes("{root}/src/deep/big.bin", test_bytes(70000, 7))?
    fs.write_bytes("{root}/src/deep/er/exact.bin", test_bytes(8192, 3))?

fn same_file(a str, b str) bool ! fs.IoError
    fs.read_bytes(a)? == fs.read_bytes(b)?

@test fn add_extract_round_trip_both_engines()
    for engine in [2, 1]
        root := "{TEST_DIR}/rt{engine}"
        make_tree("{root}/in")?
        arc := "{root}/t.clove"
        cmd_add(arc, ["{root}/in"], 4096, engine)?
        cmd_test(arc, false)?
        cmd_extract(arc, "{root}/out")?
        for f in ["empty.txt", "src/one.txt", "src/deep/big.bin", "src/deep/er/exact.bin"]
            assert(same_file("{root}/in/{f}", "{root}/out/{root}/in/{f}")?)

@test fn range_reads_at_block_boundaries()
    root := "{TEST_DIR}/range"
    make_tree("{root}/in")?
    arc := "{root}/t.clove"
    cmd_add(arc, ["{root}/in/src/deep/big.bin"], 4096, 2)?
    whole := fs.read_bytes("{root}/in/src/deep/big.bin")?
    name := "{root}/in/src/deep/big.bin"
    los := [0, 4095, 4096, 8191, 69999, 0, 100]
    his := [1, 4097, 8192, 12289, 70000, 70000, 100]
    for i in 0..los.len()
        cmd_read(arc, name, los[i], his[i], "{root}/part")?
        if los[i] < his[i]
            assert(fs.read_bytes("{root}/part")? == whole[los[i]..his[i]])

@test fn damaged_archives_give_format_errors()
    root := "{TEST_DIR}/bad"
    make_tree("{root}/in")?
    arc := "{root}/t.clove"
    cmd_add(arc, ["{root}/in/src"], 4096, 2)?
    good := fs.read_bytes(arc)?
    a0 := parse_archive(good, "good")?
    last := a0.offs.len() - 1
    data_end := a0.offs[last] + a0.clens[last]
    # Every cut before the end of the data is refused: the index says where each
    # block ends (the search trailer after the data is optional).
    for n in [0, 3, 4, 15, 16, 17, 30, 60, 100, 200, data_end / 2, data_end - 1]
        cut := parse_archive(good[0..n], "cut") else continue
        assert_eq(cut.files.len(), -1)
    # Flipping any index byte gives an error or a CRC failure, never a trap.
    index_end := a0.offs[0]
    mut flips := 0
    for pos in 4..index_end
        mut xs := good.to_list()
        xs[pos] = (xs[pos].to_int().bit_xor(255)).to_u8()
        bad := bytes.from_list(xs)
        fs.write_bytes("{root}/flip.clove", bad)?
        cmd_test("{root}/flip.clove", false) else continue
        flips += 1
    assert(flips < index_end)

@test fn unsafe_names_are_refused()
    for n in [
        "/etc/passwd",
        "../x",
        "a/../../x",
        "..\\x",
        "a\\..\\x",
        "C:x",
        "C:\\x",
        "\\\\server\\share",
        "a//b",
        "./a",
        "a/./b",
        "",
        "a\u{1}b",
    ]
        assert(not safe(n))
    for n in ["a", "a/b.txt", "src/deep/er/exact.bin", "..a", "a..", "na\u{ef}ve.txt"]
        assert(safe(n))
    assert_eq(stored_name("/abs/path.txt"), "abs/path.txt")
    assert_eq(stored_name(".\\win\\path.txt"), "win/path.txt")

@test fn executables_round_trip_through_the_filter()
    root := "{TEST_DIR}/exe"
    fs.make_dir(root)?
    mut prog := b"\x7fELF".to_list()
    for _ in 0..14
        prog.push((0).to_u8())
    prog.extend([(62).to_u8(), (0).to_u8()])
    for k in 0..3000
        rel := 50000 - k * 5
        prog.extend([
            (232).to_u8(),
            rel.bit_and(255).to_u8(),
            rel.shr(8).bit_and(255).to_u8(),
            (0).to_u8(),
            (0).to_u8(),
        ])
        prog.extend(test_bytes(3, k).to_list())
    fs.write_bytes("{root}/prog", bytes.from_list(prog))?
    for engine in [2, 1]
        arc := "{root}/p{engine}.clove"
        cmd_add(arc, ["{root}/prog"], 4096, engine)?
        a := parse_archive(fs.read_bytes(arc)?, arc)?
        assert_eq(a.engines[0].shr(4), 1)
        cmd_extract(arc, "{root}/out{engine}")?
        assert(same_file("{root}/prog", "{root}/out{engine}/{root}/prog")?)
