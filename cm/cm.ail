## Clove's max engine (engine 1): a bitwise context-mixing model with a
## long-range match model (the LZ part), two gated logistic mixers, two SSE
## stages and a carry-less arithmetic coder. Integer arithmetic only, so every
## machine produces and reads the same bytes.
##
## Per bit, eight hashed context models (orders 1-4 and 6, the current word,
## the word pair, and a sparse context that skips a byte; in machine code the two
## word contexts become instruction contexts, see end_byte), a direct order-0
## model and the match model each give a probability. A hashed slot holds a bit
## history (a state of the machine in `states`: how many zeros and ones were seen
## and which came last), and an adaptive map per order turns the state into a
## probability, so a context that has seen "0 0 0 1" and one that has seen
## "1 0 0 0" predict differently although both counted the same bits. Each
## history gives the mixers two inputs: its logit and, when it has been seen at
## all, its linear lean. Two mixers weigh the inputs, one by the partial byte and
## one by the previous byte and the match state; a final two-weight mixer per bit
## position joins them; two SSE stages refine the result by order-0 and order-1
## context. Each nibble bucket carries a check byte, so a hash collision clears
## the bucket instead of mixing two contexts' histories. Table sizes grow with
## the block (both sides know its length), so small blocks stay cheap.

NORD := 8
NIN := 19
LIMIT := 255
INIT := 1073741824
NSTATES := 175
## The history tables stop growing at 2^TCAP slots per order (a slot is one byte).
TCAP := 22
RUNCAP := 40
MIXCAP := 12

## squash/stretch as in the lpaq family: 12-bit probabilities, logits in -2047..2047.
SQ := [
    1,
    2,
    3,
    6,
    10,
    16,
    27,
    45,
    73,
    120,
    194,
    310,
    488,
    747,
    1101,
    1546,
    2047,
    2549,
    2994,
    3348,
    3607,
    3785,
    3901,
    3975,
    4022,
    4050,
    4068,
    4079,
    4085,
    4089,
    4092,
    4093,
    4094,
]

fn squash(d int) int
    if d > 2047
        return 4095
    if d < -2047
        return 0
    w := (d + 2048).bit_and(127)
    i := (d + 2048).shr(7)
    (SQ[i] * (128 - w) + SQ[i + 1] * w + 64).shr(7)

fn stretch_table() List[int]
    mut t := [0 for _ in 0..4096]
    mut pi := 0
    for x in -2047..2048
        v := squash(x)
        for i in pi..=v
            t[i] = x
        pi = v + 1
    t

fn delta_table() List[int]
    [131072 / (2 * n + 3) for n in 0..1024]

## Table slots hold a 21-bit probability over a 10-bit hit count in a u32; the count
## sets the learning rate (fast at first, then settling at 1/limit). See adapt.

fn fold(x int) int
    x.bit_xor(x.shr(32)).bit_and(268435455)

fn bits_for(n int, lo int, hi int) int
    mut b := lo
    while b < hi and (1).shl(b) < n
        b += 1
    b

## The bit-history machine. A state is (zeros, ones, last bit); seeing a bit adds
## one to its count and, when the other count is above two, halves that count (the
## statistics are nonstationary: old evidence fades). A pure run counts to RUNCAP;
## once both bits were seen the larger count stops at MIXCAP. The reachable states
## are numbered in breadth-first order from (0, 0, 0), state 0 meaning never seen;
## there are NSTATES of them. `nex[s * 2 + y]` is the state after bit y, and
## `zeros`/`ones` give each state's counts for the maps' starting probabilities.
struct States
    nex List[int]
    zeros List[int]
    ones List[int]

fn next_counts(n0 int, n1 int, y int)(int, int)
    mut a := n0
    mut b := n1
    if y == 1
        b += 1
        if a > 2
            a = a / 2 + 1
    else
        a += 1
        if b > 2
            b = b / 2 + 1
    if b == 0
        a = a.min(RUNCAP)
    elif a == 0
        b = b.min(RUNCAP)
    elif a > b
        a = a.min(MIXCAP)
    else
        b = b.min(MIXCAP)
    (a, b)

fn build_states() States
    mut ids := [0 for _ in 0..(RUNCAP + 1) * (RUNCAP + 1) * 2]
    mut zeros := [0]
    mut ones := [0]
    mut last := [0]
    mut nex := List[int]()
    ids[0] = 1
    mut head := 0
    while head < zeros.len()
        n0 := zeros[head]
        n1 := ones[head]
        for y in 0..2
            t := next_counts(n0, n1, y)
            key := (t.0 * (RUNCAP + 1) + t.1) * 2 + y
            if ids[key] == 0
                zeros.push(t.0)
                ones.push(t.1)
                last.push(y)
                ids[key] = zeros.len()
            nex.push(ids[key] - 1)
        head += 1
    States(nex: nex, zeros: zeros, ones: ones)

## The starting probability of a state: (ones + 1/2) / (zeros + ones + 1), 21 bits, count 0.
fn map_init(st States) List[int]
    [
        ((st.ones[s] * 2 + 1).shl(21) / (st.zeros[s] * 2 + st.ones[s] * 2 + 2)).shl(10)
        for s in 0..NSTATES
    ]

## The SSE curve of context `cx`: 33 points over the logit range (0..65661, so u32).
fn apm_init(nctx int) List[u32]
    curve := [(squash((j - 16) * 128) * 16).to_u32() for j in 0..33]
    [curve[k % 33] for k in 0..nctx * 33]

## The model's state. One `int` list `m` holds every scalar and every small
## table at a fixed offset, and the hot code is free functions over list
## parameters, not methods over struct fields: the compiler keeps a parameter
## list's header in registers across a loop (native.bce.11) and forwards it
## along straight-line code, which it can't do for a field. The offsets:
##
##     0 c0   1 c4   2 c8   3 word0   4 word1   5 bitpos   6 mptr   7 mlen
##     8 mctx   9 sela   10 selb   11 dota   12 dotb   13 dotf   14 pmix
##     17 nib   18 tbits   19 mbits   20 exe
##     BKT 32 (8 bucket starts)   HV 40 (8 context hashes)   CUR 48 (8 states)
##     ST 56 (19 mixer inputs)   WF 80 (16 final weights)   MSM 96 (64)
##     O0 160 (256)   NEX 416 (350)   SM 768 (8 x 175 maps)   DT 2176 (1024)
##     STR 3200 (4096 stretch)   WA 7296 (19 x 256)   WB 12160 (19 x 1024)
##
## Beside it: `t` the history slots, `a1`/`a2` the SSE curves, `mtab` the match
## table and `buf` the bytes so far.
BKT := 32
HV := 40
CUR := 48
ST := 56
WF := 80
MSM := 96
O0 := 160
NEX := 416
SM := 768
DT := 2176
STR := 3200
WA := 7296
WB := 12160
MSIZE := 31616

fn start_weight(k int) int
    if k % NIN < 1 + NORD or k % NIN >= 1 + 2 * NORD then 16000 else 4000

## The state for an `n`-byte block; `exe` is the block's executable filter (0 for data).
fn new_m(n int, exe int) List[int]
    states := build_states()
    one_map := map_init(states)
    sq := stretch_table()
    dt := delta_table()
    mut m := [0 for _ in 0..MSIZE]
    m[0] = 1
    m[14] = 2048
    m[18] = bits_for(n * 2, 12, TCAP)
    m[19] = bits_for(n, 10, 20)
    m[20] = exe
    for i in 0..16
        m[WF + i] = 32768
    for i in 0..64
        m[MSM + i] = INIT
    for i in 0..256
        m[O0 + i] = INIT
    for i in 0..NSTATES * 2
        m[NEX + i] = states.nex[i]
    for i in 0..NORD * NSTATES
        m[SM + i] = one_map[i % NSTATES]
    for i in 0..1024
        m[DT + i] = dt[i]
    for i in 0..4096
        m[STR + i] = sq[i]
    for i in 0..NIN * 256
        m[WA + i] = start_weight(i)
    for i in 0..NIN * 1024
        m[WB + i] = start_weight(i)
    m

## Bucket starts of the context models for the next nibble, and the slot within
## a bucket for the next bit. Each context hashes once per nibble to a bucket of
## 16 one-byte slots (four buckets to a cache line); the bits of the nibble so
## far pick slots 1..15, so a byte costs two cache misses per context instead
## of eight. Slot 0 holds a check byte from other bits of the hash: a bucket
## that belongs to a different context is cleared before use.
fn set_idx(mut m List[int], mut t List[u8])
    c0 := m[0]
    bitpos := m[5]
    if bitpos == 0 or bitpos == 4
        tbits := m[18]
        bmask := (1).shl(tbits - 4) - 1
        for i in 0..NORD
            h := (m[HV + i] + c0 * 40503) * 2654435761
            b := h.shr(20).bit_and(bmask).shl(4) + i.shl(tbits)
            m[BKT + i] = b
            check := h.shr(44).bit_and(255)
            if t[b].to_int() != check
                t[b] = check.to_u8()
                for k in 1..16
                    t[b + k] = (0).to_u8()
    m[17] = if bitpos < 4 then c0 else (1).shl(bitpos - 4) + c0.bit_and((1).shl(bitpos - 4) - 1)

## A slot of a map: a 21-bit probability over a 10-bit hit count. `rate` is the
## step for that count (`DT`): fast at first, then settling at 1/limit.
fn adapt(e int, y int, limit int, rate int) int
    n := e.bit_and(1023)
    p := e.shr(10)
    p2 := p + ((y.shl(21) - p) * rate) / 65536
    n2 := if n < limit then n + 1 else n
    p2.shl(10) + n2

## The probability (12 bits) that the next bit is 1. Inputs: 0 the order-0 model,
## 1..8 the histories' logits, 9 the match model, 10 a bias, 11..18 the histories'
## linear leans (0 for a context never seen).
fn predict(mut m List[int], t List[u8], a1 List[u32], a2 List[u32], buf List[u8]) int
    c0 := m[0]
    c4 := m[1]
    bitpos := m[5]
    mlen := m[7]
    nib := m[17]
    m[ST] = m[STR + m[O0 + c0].shr(19)]
    for i in 0..NORD
        # The mask makes a full-width int to store: AIL before 53fa67de stored
        # a widened sized value at its narrow width (type.num.15).
        s := t[m[BKT + i] + nib].to_int().bit_and(255)
        m[CUR + i] = s
        p := m[SM + i * NSTATES + s].shr(19)
        m[ST + 1 + i] = m[STR + p]
        m[ST + 11 + i] = if s == 0 then 0 else (p - 2048) / 4
    mut mb := 0
    mut mctx := -1
    m[ST + 9] = 0
    if mlen > 0
        e := buf[m[6]].to_int()
        if (e + 256).shr(8 - bitpos) == c0
            ebit := e.shr(7 - bitpos).bit_and(1)
            lb := if mlen < 16 then mlen else 16 + ((mlen - 16) / 8).min(15)
            mctx = lb * 2 + ebit
            m[ST + 9] = m[STR + m[MSM + mctx].shr(19)]
            mb = if mlen < 16 then 1 else if mlen < 32 then 2 else 3
    m[8] = mctx
    m[ST + 10] = 256
    sela := WA + c0 * NIN
    selb := WB + (c4.bit_and(255) + 256 * mb) * NIN
    mut da := 0
    mut db := 0
    for k in 0..NIN
        x := m[ST + k]
        da += m[sela + k] * x
        db += m[selb + k] * x
    dota := (da / 65536).max(-2047).min(2047)
    dotb := (db / 65536).max(-2047).min(2047)
    wfi := WF + bitpos * 2
    dotf := ((m[wfi] * dota + m[wfi + 1] * dotb) / 65536).max(-2047).min(2047)
    pmix := squash(dotf).max(1).min(4095)
    m[9] = sela
    m[10] = selb
    m[11] = dota
    m[12] = dotb
    m[13] = dotf
    m[14] = pmix
    # SSE: each stage interpolates its context's curve at pmix's logit.
    sp := m[STR + pmix] + 2048
    w := sp.bit_and(127)
    j1 := c0 * 33 + sp.shr(7)
    j2 := (c0 + c4.bit_and(255).shl(8)) * 33 + sp.shr(7)
    p1 := (a1[j1].to_int() * (128 - w) + a1[j1 + 1].to_int() * w).shr(11)
    p2 := (a2[j2].to_int() * (128 - w) + a2[j2 + 1].to_int() * w).shr(11)
    ((pmix + p1 + 2 * p2) / 4).max(1).min(4095)

## Learns the bit `y` that `predict` just gave a probability for, and moves on.
fn update(
    mut m List[int],
    mut t List[u8],
    mut a1 List[u32],
    mut a2 List[u32],
    mut buf List[u8],
    mut mtab List[u32],
    y int,
)
    c0 := m[0]
    c4 := m[1]
    bitpos := m[5]
    nib := m[17]
    sela := m[9]
    selb := m[10]
    dota := m[11]
    dotb := m[12]
    pmix := m[14]
    # A step is (input * error + 32768) / 65536 with inputs within +-2047, so an
    # error within +-16 moves no weight: those loops are skipped, same bytes.
    ea := (y.shl(12) - squash(dota)) * 6
    if ea > 16 or ea < -16
        for k in 0..NIN
            m[sela + k] += (m[ST + k] * ea + 32768) / 65536
    eb := (y.shl(12) - squash(dotb)) * 6
    if eb > 16 or eb < -16
        for k in 0..NIN
            m[selb + k] += (m[ST + k] * eb + 32768) / 65536
    ef := (y.shl(12) - pmix) * 2
    wfi := WF + bitpos * 2
    m[wfi] += (dota * ef + 32768) / 65536
    m[wfi + 1] += (dotb * ef + 32768) / 65536
    sp := m[STR + pmix] + 2048
    j0 := sp.shr(7)
    near := if sp.bit_and(127) < 64 then j0 else j0 + 1
    g := y.shl(16) + y.shl(7) - y - y
    j1 := c0 * 33 + near
    v1 := a1[j1].to_int()
    a1[j1] = (v1 + (g - v1) / 128).to_u32()
    j2 := (c0 + c4.bit_and(255).shl(8)) * 33 + near
    v2 := a2[j2].to_int()
    a2[j2] = (v2 + (g - v2) / 128).to_u32()
    e0 := m[O0 + c0]
    m[O0 + c0] = adapt(e0, y, LIMIT, m[DT + e0.bit_and(1023)])
    for i in 0..NORD
        hs := m[CUR + i]
        j := SM + i * NSTATES + hs
        es := m[j]
        m[j] = adapt(es, y, LIMIT, m[DT + es.bit_and(1023)])
        t[m[BKT + i] + nib] = m[NEX + hs * 2 + y].to_u8()
    mctx := m[8]
    if mctx >= 0
        em := m[MSM + mctx]
        m[MSM + mctx] = adapt(em, y, 1023, m[DT + em.bit_and(1023)])
    if bitpos == 7
        end_byte(mut m, mut buf, mut mtab, c0 * 2 + y - 256)
        m[0] = 1
        m[5] = 0
    else
        m[0] = c0 * 2 + y
        m[5] = bitpos + 1
    set_idx(mut m, mut t)

fn end_byte(mut m List[int], mut buf List[u8], mut mtab List[u32], b int)
    buf.push(b.to_u8())
    c8 := m[2].shl(8).bit_and(4294967295).bit_or(m[1].shr(24))
    c4 := m[1].shl(8).bit_and(4294967295).bit_or(b)
    m[1] = c4
    m[2] = c8
    mut word0 := m[3]
    mut word1 := m[4]
    lower := if b >= 65 and b <= 90 then b + 32 else b
    if (lower >= 97 and lower <= 122) or b >= 128
        word0 = (word0 * 263 + lower).bit_and(1073741823)
    elif word0 != 0
        word1 = word0
        word0 = 0
    m[3] = word0
    m[4] = word1
    m[HV] = c4.bit_and(255) * 65599 + 1
    m[HV + 1] = c4.bit_and(65535) * 31 + 2
    m[HV + 2] = fold(c4.bit_and(16777215) * 2246822519) + 3
    m[HV + 3] = fold(c4.shr(16) * 2246822519 + c4.bit_and(65535) * 3266489917) + 4
    m[HV + 4] = fold(c4.bit_xor(c8.bit_and(65535) * 2654435761)) + 5
    n := buf.len()
    if m[20] == 0
        m[HV + 5] = fold(word0 * 2654435761) + 6
        m[HV + 6] = fold(word0.bit_xor(word1 * 1000003) * 97) + 7
    else
        # Machine code: bytes 1 and 3 back (an opcode and its operand around a
        # ModRM byte), and the column in a 4-byte word with the bytes 4 and 8 back
        # (the same field of the previous instructions on ARM64, table entries on x86).
        m[HV + 5] = fold((c4.bit_and(16711935) + 16777216) * 2654435761) + 6
        m[HV + 6] = fold((n.bit_and(3) + c4.shr(24).shl(2) + c8.shr(24).shl(10)) * 2246822519) + 7
    m[HV + 7] = fold(c4.shr(8).bit_and(65535) * 2246822519) + 8
    mut mlen := m[7]
    mut mptr := m[6]
    if mlen > 0 and buf[mptr].to_int() == b
        mlen += 1
        mptr += 1
    else
        mlen = 0
    h := (fold(c4 + c8.bit_and(255).shl(32)) * 789008181).shr(20).bit_and((1).shl(m[19]) - 1)
    if mlen == 0
        # Masked for a full-width int, as in predict.
        cand := mtab[h].to_int().bit_and(4294967295)
        if cand > 0
            mut k := 0
            while k < 32 and cand - 1 - k >= 0 and buf[cand - 1 - k] == buf[n - 1 - k]
                k += 1
            if k >= 5
                mlen = k
                mptr = cand
    mtab[h] = n.to_u32()
    m[6] = mptr
    m[7] = mlen

struct Coder
    out List[u8]
    x1 int
    x2 int

## Compresses `d` to a self-contained block; `exe` as for new_m.
pub fn compress(d List[u8], exe int) List[u8]
    mut m := new_m(d.len(), exe)
    mut t := [(0).to_u8() for _ in 0..NORD * (1).shl(m[18])]
    mut mtab := [(0).to_u32() for _ in 0..(1).shl(m[19])]
    mut a1 := apm_init(256)
    mut a2 := apm_init(65536)
    mut buf := List[u8]()
    set_idx(mut m, mut t)
    mut c := Coder(out: [], x1: 0, x2: 4294967295)
    for byte in d
        b := byte.to_int()
        mut i := 7
        while i >= 0
            y := b.shr(i).bit_and(1)
            p := predict(mut m, t, a1, a2, buf)
            xmid := c.x1 + (c.x2 - c.x1).shr(12) * p
            if y == 1
                c.x2 = xmid
            else
                c.x1 = xmid + 1
            update(mut m, mut t, mut a1, mut a2, mut buf, mut mtab, y)
            while c.x1.bit_xor(c.x2).bit_and(4278190080) == 0
                c.out.push(c.x2.shr(24).to_u8())
                c.x1 = c.x1.shl(8).bit_and(4294967295)
                c.x2 = c.x2.shl(8).bit_and(4294967295).bit_or(255)
            i -= 1
    c.out.push(c.x1.shr(24).to_u8())
    c.out.push(c.x1.shr(16).bit_and(255).to_u8())
    c.out.push(c.x1.shr(8).bit_and(255).to_u8())
    c.out.push(c.x1.bit_and(255).to_u8())
    c.out

## Decodes `n` bytes. A damaged block gives wrong bytes, which the caller's CRC catches.
pub fn decompress(src List[u8], n int, exe int) List[u8]
    mut m := new_m(n, exe)
    mut t := [(0).to_u8() for _ in 0..NORD * (1).shl(m[18])]
    mut mtab := [(0).to_u32() for _ in 0..(1).shl(m[19])]
    mut a1 := apm_init(256)
    mut a2 := apm_init(65536)
    mut buf := List[u8]()
    set_idx(mut m, mut t)
    mut pos := 0
    mut x := 0
    for _ in 0..4
        x = x.shl(8).bit_or(if pos < src.len() then src[pos].to_int() else 0)
        pos += 1
    mut x1 := 0
    mut x2 := 4294967295
    for _byte in 0..n
        for _bit in 0..8
            p := predict(mut m, t, a1, a2, buf)
            xmid := x1 + (x2 - x1).shr(12) * p
            mut y := 0
            if x <= xmid
                y = 1
                x2 = xmid
            else
                x1 = xmid + 1
            update(mut m, mut t, mut a1, mut a2, mut buf, mut mtab, y)
            while x1.bit_xor(x2).bit_and(4278190080) == 0
                x1 = x1.shl(8).bit_and(4294967295)
                x2 = x2.shl(8).bit_and(4294967295).bit_or(255)
                nb := if pos < src.len() then src[pos].to_int() else 0
                x = x.shl(8).bit_and(4294967295).bit_or(nb)
                pos += 1
    buf

@test fn state_machine_is_closed_and_numbered()
    st := build_states()
    assert_eq(st.zeros.len(), NSTATES)
    assert_eq(st.nex.len(), NSTATES * 2)
    for x in st.nex
        assert(x >= 0 and x < NSTATES)
    # a run of ones climbs; a zero after it halves the ones
    mut s := 0
    for _ in 0..10
        s = st.nex[s * 2 + 1]
    assert_eq(st.ones[s], 10)
    s = st.nex[s * 2]
    assert_eq(st.ones[s], 6)
    assert_eq(st.zeros[s], 1)
    m := map_init(st)
    assert(m[s].shr(19) > 2048)
    assert(m[0].shr(19) == 2048)

@test fn roundtrips_text()
    mut d := List[u8]()
    for i in 0..3000
        d.push((97 + (i * i).bit_xor(i / 7) % 5).to_u8())
    c := compress(d, 0)
    assert(c.len() < d.len())
    assert_eq(decompress(c, d.len(), 0), d)
    assert_eq(decompress(compress(d, 1), d.len(), 1), d)

@test fn roundtrips_tiny()
    for n in 0..5
        d := [(200).to_u8() for _ in 0..n]
        assert_eq(decompress(compress(d, 0), n, 0), d)

@test fn roundtrips_words_and_binary()
    text := "the quick brown fox jumps over the lazy dog; The Quick Brown Fox! ".to_bytes()
    mut d := List[u8]()
    for i in 0..400
        for x in text
            d.push(x)
        d.push((i * 37).bit_and(255).to_u8())
    c := compress(d, 0)
    assert(c.len() * 4 < d.len())
    assert_eq(decompress(c, d.len(), 0), d)
