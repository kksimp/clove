## Clove's fast engine (engine 2): LZ77 with hash chains and lazy matching,
## then an adaptive binary range coder. The model follows the LZMA family: a
## 12-state machine, four repeat distances and a one-byte repeat, contexts by
## position mod 4, literals by the previous byte, matched literals after a match.
## Decoding does no searching, so it runs far faster than the CM engine.

MINLEN := 4
MAXLEN := 273
HSIZE := 262144
TOP := 16777216

IS_MATCH := 0
IS_REP := 48
IS_G0 := 60
IS_G1 := 72
IS_G2 := 84
IS_LONG := 96
LIT := 144
LEN_MATCH := 12432
LEN_REP := 12754
SLOT := 13076
SPEC := 13332
ALIGN := 14356
PROBS := 14372

struct Enc
    out List[u8]
    lo int
    rng int
    cache int
    csize int
    p List[int]

fn Enc.shift_low(mut self)
    if lo < 4278190080 or lo >= 4294967296
        carry := lo.shr(32)
        out.push((cache + carry).bit_and(255).to_u8())
        csize -= 1
        while csize > 0
            out.push((255 + carry).bit_and(255).to_u8())
            csize -= 1
        cache = lo.shr(24).bit_and(255)
    csize += 1
    lo = lo.bit_and(16777215).shl(8)

fn Enc.bit(mut self, i int, b int)
    pr := p[i]
    bound := rng.shr(11) * pr
    if b == 0
        rng = bound
        p[i] = pr + (2048 - pr).shr(5)
    else
        lo += bound
        rng -= bound
        p[i] = pr - pr.shr(5)
    while rng < TOP
        rng = rng.shl(8)
        shift_low()

fn Enc.direct(mut self, v int, nbits int)
    mut i := nbits - 1
    while i >= 0
        rng = rng.shr(1)
        if v.shr(i).bit_and(1) == 1
            lo += rng
        while rng < TOP
            rng = rng.shl(8)
            shift_low()
        i -= 1

fn Enc.tree(mut self, base int, nbits int, v int)
    mut m := 1
    mut i := nbits - 1
    while i >= 0
        b := v.shr(i).bit_and(1)
        bit(base + m, b)
        m = m * 2 + b
        i -= 1

fn Enc.rtree(mut self, base int, nbits int, v int)
    mut m := 1
    for i in 0..nbits
        b := v.shr(i).bit_and(1)
        bit(base + m, b)
        m = m * 2 + b

fn Enc.lit(mut self, prevb int, v int, mb int, matched bool)
    base := LIT + prevb.shr(4) * 768
    mut m := 1
    mut mt := matched
    mut i := 7
    while i >= 0
        b := v.shr(i).bit_and(1)
        if mt
            mbit := mb.shr(i).bit_and(1)
            bit(base + 256 + mbit * 256 + m, b)
            if mbit != b
                mt = false
        else
            bit(base + m, b)
        m = m * 2 + b
        i -= 1

## Length l - 2 (0..271) with a context of the position mod 4.
fn Enc.mlen(mut self, base int, l int, ps int)
    if l < 8
        bit(base, 0)
        tree(base + 2 + ps * 8, 3, l)
    elif l < 16
        bit(base, 1)
        bit(base + 1, 0)
        tree(base + 34 + ps * 8, 3, l - 8)
    else
        bit(base, 1)
        bit(base + 1, 1)
        tree(base + 66, 8, l - 16)

fn slot_of(d int) int
    if d < 4
        return d
    mut n := 0
    mut t := d
    while t > 1
        t = t.shr(1)
        n += 1
    2 * n + d.shr(n - 1).bit_and(1)

fn Enc.dist(mut self, l int, d int)
    s := slot_of(d)
    ctx := if l > 3 then 3 else l
    tree(SLOT + ctx * 64, 6, s)
    if s >= 4
        n := s.shr(1) - 1
        base := (2 + s.bit_and(1)).shl(n)
        e := d - base
        if n > 4
            direct(e.shr(4), n - 4)
            rtree(ALIGN, 4, e.bit_and(15))
        else
            rtree(SPEC + s * 16, n, e)

fn after_lit(s int) int
    if s < 4
        return 0
    if s < 10
        return s - 3
    s - 6

fn after_match(s int) int
    if s < 7 then 7 else 10

fn after_rep(s int) int
    if s < 7 then 8 else 11

fn after_short(s int) int
    if s < 7 then 9 else 11

## Moves repeat distance `i` to the front.
fn rep_front(mut reps List[int], i int)
    d := reps[i]
    mut k := i
    while k > 0
        reps[k] = reps[k - 1]
        k -= 1
    reps[0] = d

fn rep_push(mut reps List[int], d int)
    reps[3] = reps[2]
    reps[2] = reps[1]
    reps[1] = reps[0]
    reps[0] = d

fn hash4(d List[u8], pos int) int
    v := d[pos].to_int()
        + d[pos + 1].to_int().shl(8)
        + d[pos + 2].to_int().shl(16)
        + d[pos + 3].to_int().shl(24)
    (v * 789008181).shr(20).bit_and(262143)

fn ins(mut head List[int], mut prev List[int], d List[u8], pos int, n int)
    if pos + MINLEN <= n
        h := hash4(d, pos)
        prev[pos] = head[h]
        head[h] = pos + 1

fn match_len(d List[u8], a int, b int, limit int) int
    mut k := 0
    while k < limit and d[a + k] == d[b + k]
        k += 1
    k

## The longest earlier match for `pos`: (length, distance - 1), length 0 if none.
fn find(d List[u8], prev List[int], head List[int], pos int, n int, depth int)(int, int)
    if pos + MINLEN > n
        return (0, 0)
    limit := MAXLEN.min(n - pos)
    mut best := 0
    mut bd := 0
    mut cand := head[hash4(d, pos)]
    mut tries := depth
    while cand > 0 and tries > 0
        c := cand - 1
        if d[c + best] == d[pos + best]
            l := match_len(d, c, pos, limit)
            if l > best
                best = l
                bd = pos - c - 1
                if l >= limit
                    break
        cand = prev[c]
        tries -= 1
    (best, bd)

fn depth_of(level int) int
    if level <= 1
        return 4
    if level == 2
        return 8
    if level == 3
        return 16
    if level == 4
        return 32
    if level == 5
        return 64
    if level == 6
        return 128
    256

## Compresses `d` (bytes as ints) to a self-contained range-coded block.## Compresses `d` (bytes as ints) to a self-contained range-coded block.
pub fn compress(d List[u8], level int) List[u8]
    n := d.len()
    depth := depth_of(level)
    lazy := level >= 3
    mut e := Enc(out: [], lo: 0, rng: 4294967295, cache: 0, csize: 1, p: [1024 for _ in 0..PROBS])
    mut head := [0 for _ in 0..HSIZE]
    mut prev := [0 for _ in 0..n]
    mut reps := [0, 0, 0, 0]
    mut pos := 0
    mut state := 0
    mut have := false
    mut l1 := 0
    mut d1 := 0
    while pos < n
        if not have
            t := find(d, prev, head, pos, n, depth)
            l1 = t.0
            d1 = t.1
        have = false
        ps := pos.bit_and(3)
        limit := MAXLEN.min(n - pos)
        mut ri := -1
        mut rl := 0
        for k in 0..4
            if pos > reps[k]
                l := match_len(d, pos - reps[k] - 1, pos, limit)
                if l > rl
                    rl = l
                    ri = k
        ins(mut head, mut prev, d, pos, n)
        if rl >= 2 and rl + 1 >= l1
            e.bit(IS_MATCH + state * 4 + ps, 1)
            e.bit(IS_REP + state, 1)
            if ri == 0
                e.bit(IS_G0 + state, 0)
                e.bit(IS_LONG + state * 4 + ps, 1)
            else
                e.bit(IS_G0 + state, 1)
                if ri == 1
                    e.bit(IS_G1 + state, 0)
                else
                    e.bit(IS_G1 + state, 1)
                    e.bit(IS_G2 + state, ri - 2)
                rep_front(mut reps, ri)
            e.mlen(LEN_REP, rl - 2, ps)
            for k in 1..rl
                ins(mut head, mut prev, d, pos + k, n)
            pos += rl
            state = after_rep(state)
            continue
        if l1 >= MINLEN
            if lazy and l1 < 32 and pos + 1 < n
                t2 := find(d, prev, head, pos + 1, n, depth)
                if t2.0 > l1 + 1
                    l1 = t2.0
                    d1 = t2.1
                    have = true
            if not have
                e.bit(IS_MATCH + state * 4 + ps, 1)
                e.bit(IS_REP + state, 0)
                e.mlen(LEN_MATCH, l1 - 2, ps)
                e.dist(l1 - 2, d1)
                for k in 1..l1
                    ins(mut head, mut prev, d, pos + k, n)
                pos += l1
                rep_push(mut reps, d1)
                state = after_match(state)
                continue
        mb := if pos > reps[0] then d[pos - reps[0] - 1].to_int() else -1
        if mb == d[pos].to_int()
            e.bit(IS_MATCH + state * 4 + ps, 1)
            e.bit(IS_REP + state, 1)
            e.bit(IS_G0 + state, 0)
            e.bit(IS_LONG + state * 4 + ps, 0)
            pos += 1
            state = after_short(state)
            continue
        e.bit(IS_MATCH + state * 4 + ps, 0)
        prevb := if pos > 0 then d[pos - 1].to_int() else 0
        e.lit(prevb, d[pos].to_int(), mb, state >= 7)
        pos += 1
        state = after_lit(state)
    for _ in 0..5
        e.shift_low()
    e.out

struct Dec
    src List[u8]
    pos int
    code int
    rng int
    p List[int]

fn Dec.norm(mut self)
    if rng < TOP
        rng = rng.shl(8)
        nb := if pos < src.len() then src[pos].to_int() else 0
        code = code.shl(8).bit_or(nb)
        pos += 1

fn Dec.bit(mut self, i int) int
    pr := p[i]
    bound := rng.shr(11) * pr
    mut b := 0
    if code < bound
        rng = bound
        p[i] = pr + (2048 - pr).shr(5)
    else
        code -= bound
        rng -= bound
        p[i] = pr - pr.shr(5)
        b = 1
    norm()
    b

fn Dec.direct(mut self, nbits int) int
    mut v := 0
    for _ in 0..nbits
        rng = rng.shr(1)
        mut b := 0
        if code >= rng
            code -= rng
            b = 1
        v = v.shl(1).bit_or(b)
        norm()
    v

fn Dec.tree(mut self, base int, nbits int) int
    mut m := 1
    for _ in 0..nbits
        m = m * 2 + bit(base + m)
    m - (1).shl(nbits)

fn Dec.rtree(mut self, base int, nbits int) int
    mut m := 1
    mut v := 0
    for i in 0..nbits
        b := bit(base + m)
        m = m * 2 + b
        v = v.bit_or(b.shl(i))
    v

fn Dec.lit(mut self, prevb int, mb int, matched bool) int
    base := LIT + prevb.shr(4) * 768
    mut m := 1
    mut mt := matched
    mut i := 7
    while i >= 0
        mut b := 0
        if mt
            mbit := mb.shr(i).bit_and(1)
            b = bit(base + 256 + mbit * 256 + m)
            if mbit != b
                mt = false
        else
            b = bit(base + m)
        m = m * 2 + b
        i -= 1
    m - 256

fn Dec.mlen(mut self, base int, ps int) int
    if bit(base) == 0
        return tree(base + 2 + ps * 8, 3)
    if bit(base + 1) == 0
        return 8 + tree(base + 34 + ps * 8, 3)
    16 + tree(base + 66, 8)

fn Dec.dist(mut self, l int) int
    ctx := if l > 3 then 3 else l
    s := tree(SLOT + ctx * 64, 6)
    if s < 4
        return s
    n := s.shr(1) - 1
    base := (2 + s.bit_and(1)).shl(n)
    if n > 4
        hi := direct(n - 4)
        lo := rtree(ALIGN, 4)
        return base + hi.shl(4) + lo
    base + rtree(SPEC + s * 16, n)

## Decodes `n` bytes from a block made by `compress`. A damaged block gives
## an empty list (the caller checks the length and the CRC).
pub fn decompress(src List[u8], n int) List[u8]
    if src.len() < 5
        return []
    code := src[1]
        .to_int()
        .shl(24)
        .bit_or(src[2].to_int().shl(16))
        .bit_or(src[3].to_int().shl(8))
        .bit_or(src[4].to_int())
    mut dc := Dec(src: src, pos: 5, code: code, rng: 4294967295, p: [1024 for _ in 0..PROBS])
    mut out := List[u8]()
    mut state := 0
    mut reps := [0, 0, 0, 0]
    while out.len() < n
        pos := out.len()
        ps := pos.bit_and(3)
        if dc.bit(IS_MATCH + state * 4 + ps) == 0
            prevb := if pos > 0 then out[pos - 1].to_int() else 0
            mb := if pos > reps[0] then out[pos - reps[0] - 1].to_int() else -1
            out.push(dc.lit(prevb, mb, state >= 7).to_u8())
            state = after_lit(state)
            continue
        mut l := 0
        if dc.bit(IS_REP + state) == 1
            if dc.bit(IS_G0 + state) == 0
                if dc.bit(IS_LONG + state * 4 + ps) == 0
                    if pos <= reps[0]
                        return []
                    out.push(out[pos - reps[0] - 1])
                    state = after_short(state)
                    continue
            elif dc.bit(IS_G1 + state) == 0
                rep_front(mut reps, 1)
            else
                rep_front(mut reps, 2 + dc.bit(IS_G2 + state))
            l = dc.mlen(LEN_REP, ps) + 2
            state = after_rep(state)
        else
            l = dc.mlen(LEN_MATCH, ps)
            rep_push(mut reps, dc.dist(l))
            l += 2
            state = after_match(state)
        at := pos - reps[0] - 1
        if at < 0 or pos + l > n
            return []
        for k in 0..l
            out.push(out[at + k])
    out

@test fn roundtrips_text()
    mut d := List[u8]()
    for i in 0..3000
        d.push((97 + (i * i).bit_xor(i / 7) % 5).to_u8())
    for level in 1..=6
        c := compress(d, level)
        assert(c.len() < d.len())
        assert_eq(decompress(c, d.len()), d)

@test fn roundtrips_empty_and_tiny()
    for n in 0..9
        d := [(7).to_u8() for _ in 0..n]
        assert_eq(decompress(compress(d, 5), n), d)

@test fn roundtrips_repeat_distances()
    words := [
        "hello".to_bytes().to_list(),
        "world".to_bytes().to_list(),
        "ail".to_bytes().to_list(),
    ]
    mut d := List[u8]()
    for i in 0..2000
        d.extend(words[(i * 7 + i / 3) % 3])
        d.push((32 + i % 2).to_u8())
        d.push(((i * 31) % 256).to_u8())
    for level in [1, 5]
        assert_eq(decompress(compress(d, level), d.len()), d)
